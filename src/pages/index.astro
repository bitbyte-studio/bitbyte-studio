---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import AboutContact from '../components/AboutContact.astro';
import Footer from '../components/Footer.astro';
import SiteModals from '../components/SiteModals.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<BaseLayout>
  <div class="min-h-screen bg-[#131315] text-[#e5e1e4] flex flex-col font-inter">
    <Navbar />
    <main id="contenido" tabindex="-1" class="outline-none">
      <Hero />
      <Services />
      <Portfolio />
      <Process />
      <Faq />

      <section class="surface-light bg-[#F7F5F2] py-20 md:py-[120px]">
        <div class="max-w-[1280px] mx-auto px-4 md:px-6">
          <AboutContact />
        </div>
      </section>
    </main>

    <Footer />
    <SiteModals />
    <WhatsAppFloat />
  </div>
</BaseLayout>
