---
import { PRICING_PLANS } from '../data';
---

<section id="precios" class="bg-[#131315] py-20 md:py-[120px] px-4 md:px-6">
  <div class="max-w-[1280px] mx-auto">
    <div class="mb-14 md:mb-16 text-center flex flex-col items-center">
      <p class="font-technical text-sm font-bold text-[#fd625d] mb-2 uppercase tracking-widest">// precios</p>
      <h2 class="font-sora text-3xl md:text-4xl lg:text-[40px] font-bold text-white mb-4">
        Inversión en tu éxito
      </h2>
      <p class="font-inter text-sm md:text-base text-[#9CA3AF] max-w-xl">
        Precios claros y predecibles sin costos ocultos. Todos nuestros planes incluyen código propiedad 100% del cliente y garantía técnica de rendimiento.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        PRICING_PLANS.map((plan) => {
          const isPopular = plan.popular;
          return (
            <div
              class:list={[
                'p-8 md:p-10 rounded-2xl flex flex-col justify-between hover-lift transition-all relative overflow-hidden',
                isPopular
                  ? 'bg-[#1A1A1A] border-2 border-[#fd625d] shadow-2xl'
                  : 'bg-[#1A1A1A] border border-[#2A2A2A]',
              ]}
            >
              {isPopular && (
                <div class="absolute top-0 right-0 bg-[#fd625d] text-white text-[10px] px-4 py-1 font-technical uppercase tracking-widest font-bold">
                  Popular
                </div>
              )}

              <div>
                <h3 class="font-sora text-2xl md:text-3xl font-bold text-white mb-3">{plan.name}</h3>
                <p class="text-[#9CA3AF] text-sm font-inter mb-8">{plan.description}</p>
                <div class="text-[#fd625d] text-4xl sm:text-5xl font-bold font-sora mb-8 flex items-baseline">
                  {plan.price}
                  <span class="text-base font-normal text-[#9CA3AF] font-inter ml-1">{plan.period}</span>
                </div>
                <ul class="space-y-4 mb-10">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-3 text-white font-inter text-sm">
                      <span class="material-symbols-outlined text-[#fd625d] shrink-0 text-xl">check_circle</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <button
                type="button"
                data-open-quote={plan.name}
                class:list={[
                  'w-full py-4 rounded-full font-sora text-sm font-semibold transition-all',
                  isPopular
                    ? 'bg-[#fd625d] text-white glow-coral hover:scale-105'
                    : 'border border-white text-white hover:bg-white hover:text-[#131315]',
                ]}
              >
                {plan.ctaText}
              </button>
            </div>
          );
        })
      }
    </div>

    <div class="mt-14 p-8 rounded-2xl bg-[#1A1A1A] border border-[#2A2A2A] flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-[#58ddb0]/20 text-[#58ddb0] flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl">calculate</span>
        </div>
        <div>
          <h4 class="font-sora text-lg md:text-xl font-bold text-white mb-1">
            ¿Necesitas un sistema personalizado o hardware IoT?
          </h4>
          <p class="font-inter text-sm text-[#9CA3AF]">
            Prueba nuestro Cotizador Interactivo en vivo y calcula el tiempo y costo de tu solución a medida.
          </p>
        </div>
      </div>

      <button
        type="button"
        data-open-quote
        class="w-full md:w-auto bg-white text-[#131315] px-8 py-3.5 rounded-full font-sora text-sm font-bold hover:bg-[#ffb3ad] hover:text-[#131315] transition-colors whitespace-nowrap"
      >
        Abrir Cotizador Interactivo //
      </button>
    </div>
  </div>
</section>

<script>
  import { openQuote } from '../lib/events';

  function bindQuoteButtons() {
    document.querySelectorAll<HTMLElement>('[data-open-quote]').forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const service = button.getAttribute('data-open-quote') || undefined;
        openQuote(service || undefined);
      });
    });
  }

  bindQuoteButtons();
  document.addEventListener('astro:page-load', bindQuoteButtons);
</script>
