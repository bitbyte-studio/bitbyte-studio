---
import { whatsappLink } from '../config/contact';

const WA_MESSAGE = '¡Hola Bit & Byte Studio! Quiero una página para mi negocio.';
const waHref = whatsappLink(WA_MESSAGE);

const navLinks = [
  { label: 'Inicio', href: '#inicio', id: 'inicio' },
  { label: 'Servicios', href: '#servicios', id: 'servicios' },
  { label: 'Ejemplos', href: '#portafolio', id: 'portafolio' },
  { label: 'Proceso', href: '#proceso', id: 'proceso' },
  { label: 'Contacto', href: '#contacto', id: 'contacto' },
];
---

<header
  class="navbar sticky top-0 z-50 border-b border-[#353437]/70 bg-[#131315]/72 backdrop-blur-xl text-[#ffb3ad] transition-[background-color,box-shadow,border-color] duration-300"
  data-navbar
  data-scrolled="false"
>
  <div class="flex justify-between items-center w-full px-4 md:px-6 max-w-[1280px] mx-auto h-[4.5rem] md:h-20">
    <a
      href="#inicio"
      class="font-sora text-2xl md:text-[1.85rem] font-bold text-[#e5e1e4] hover:opacity-90 transition-opacity flex items-center gap-1.5 shrink-0"
    >
      Bit <span class="ampersand text-[#ffb3ad]">&amp;</span> Byte
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link={link.id}
            class:list={[
              'navbar-link font-sora text-sm font-semibold transition-colors px-3 py-2 rounded-full',
              link.id === 'inicio' ? 'is-active text-[#ffb3ad]' : 'text-[#e1bfbb] hover:text-[#ffb3ad]',
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        data-track="whatsapp"
        data-track-source="nav"
        aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
        class="bg-coral-strong hover:bg-coral-strong-hover text-white px-5 py-2.5 rounded-full font-sora text-sm font-semibold transition-[transform,background-color] hover:scale-[1.03] glow-coral flex items-center gap-2 ml-3"
      >
        <span>Escribir por WhatsApp</span>
      </a>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
      <button
        type="button"
        data-menu-toggle
        class="p-2.5 rounded-full text-[#e5e1e4] hover:text-[#ffb3ad] hover:bg-white/5 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <span class="material-symbols-outlined text-2xl" data-menu-icon aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <div
    id="menu-movil"
    data-mobile-menu
    class="navbar-mobile lg:hidden border-b border-[#353437] px-4 pb-5 pt-1 space-y-4 hidden"
    hidden
  >
    <nav class="flex flex-col gap-1" aria-label="Navegación móvil">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link={link.id}
            data-mobile-link
            class:list={[
              'font-sora text-base font-semibold transition-colors rounded-xl px-3 py-3',
              link.id === 'inicio' ? 'is-active text-[#ffb3ad] bg-white/5' : 'text-[#e5e1e4] hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="pt-3 border-t border-[#353437]">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        data-close-menu
        data-track="whatsapp"
        data-track-source="menu-movil"
        aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
        class="w-full text-center bg-coral-strong hover:bg-coral-strong-hover text-white py-3 rounded-full font-sora text-sm font-semibold glow-coral block transition-colors"
      >
        Escribir por WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  import { mountAll } from '../lib/lifecycle';

  const SECTIONS = ['inicio', 'servicios', 'portafolio', 'proceso', 'contacto'];

  function initNavbar(root: HTMLElement, signal: AbortSignal) {
    const menu = root.querySelector<HTMLElement>('[data-mobile-menu]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const icon = root.querySelector<HTMLElement>('[data-menu-icon]');
    const links = Array.from(root.querySelectorAll<HTMLElement>('[data-nav-link]'));

    if (!menu || !toggle || !icon) return;

    const setMenuOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      icon.textContent = open ? 'close' : 'menu';
    };

    const setActiveSection = (id: string) => {
      links.forEach((link) => {
        const active = link.dataset.navLink === id;
        const isMobile = link.hasAttribute('data-mobile-link');
        link.classList.toggle('is-active', active);

        if (isMobile) {
          link.classList.toggle('text-[#ffb3ad]', active);
          link.classList.toggle('bg-white/5', active);
          link.classList.toggle('text-[#e5e1e4]', !active);
        } else {
          link.classList.toggle('text-[#ffb3ad]', active);
          link.classList.toggle('text-[#e1bfbb]', !active);
        }
      });
    };

    const onScroll = () => {
      root.dataset.scrolled = String(window.scrollY > 16);

      const scrollPos = window.scrollY + root.offsetHeight + 24;
      let current = SECTIONS[0];
      for (const id of SECTIONS) {
        const el = document.getElementById(id);
        if (!el) continue;
        if (el.offsetTop <= scrollPos) current = id;
      }
      setActiveSection(current);
    };

    toggle.addEventListener(
      'click',
      () => {
        setMenuOpen(Boolean(menu.hidden));
      },
      { signal },
    );

    root.querySelectorAll<HTMLElement>('[data-mobile-link], [data-close-menu]').forEach((el) => {
      el.addEventListener('click', () => setMenuOpen(false), { signal });
    });

    window.addEventListener('scroll', onScroll, { passive: true, signal });
    onScroll();
  }

  mountAll('[data-navbar]', initNavbar);
</script>
