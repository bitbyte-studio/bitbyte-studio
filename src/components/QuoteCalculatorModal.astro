---
const projectTypes = [
  { id: 'landing', label: 'Landing Page', base: 499, weeks: 3 },
  { id: 'webapp', label: 'Web App / SaaS', base: 999, weeks: 5 },
  { id: 'ecommerce', label: 'E-commerce', base: 1499, weeks: 6 },
  { id: 'hardware', label: 'Hardware / IoT', base: 1800, weeks: 8 },
] as const;

const addons = [
  { id: 'cms', label: 'CMS Auto-gestionable (Sanity / Headless)', price: 200, checked: true },
  { id: 'seo', label: 'SEO Técnico Avanzado & Schema OpenGraph', price: 150, checked: false },
  { id: 'animations', label: 'Animaciones 3D (Three.js / GSAP en capas)', price: 300, checked: false },
  { id: 'automation', label: 'Integración APIs y Flujos Automatizados', price: 250, checked: false },
  { id: 'priority', label: 'Entrega Prioritaria (Sprint Ágil en 14 días)', price: 400, checked: false },
] as const;

const PAGE_PRICE = 80;
const PRIORITY_WEEKS = 2;
const initialPages = 3;

const money = (value: number) => value.toLocaleString('en-US');

// Defaults must match the calculator: first project type + initial pages + pre-checked add-ons
const initialType = projectTypes[0];
const initialTotal =
  initialType.base +
  (initialPages - 1) * PAGE_PRICE +
  addons.filter((addon) => addon.checked).reduce((sum, addon) => sum + addon.price, 0);
const initialWeeks = initialType.weeks;
---

<div
  data-quote-modal
  data-page-price={PAGE_PRICE}
  data-priority-weeks={PRIORITY_WEEKS}
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fadeIn hidden"
  hidden
>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="quote-title"
    tabindex="-1"
    class="bg-[#1A1A1A] border border-[#353437] rounded-2xl w-full max-w-3xl max-h-[92vh] overflow-y-auto shadow-2xl text-white outline-none"
  >
    <div class="sticky top-0 bg-[#1A1A1A]/95 backdrop-blur-md border-b border-[#2A2A2A] px-6 py-4 flex items-center justify-between z-10">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-[#58ddb0]" aria-hidden="true"></span>
        <span class="font-technical text-xs text-[#58ddb0] uppercase tracking-wider">
          // COTIZADOR INTERACTIVO DE INGENIERÍA · BIT &amp; BYTE
        </span>
      </div>
      <button
        type="button"
        data-quote-close
        class="w-8 h-8 rounded-full bg-[#2A2A2A] hover:bg-[#353437] flex items-center justify-center text-[#9CA3AF] hover:text-white transition-colors"
        aria-label="Cerrar cotizador"
      >
        <span class="material-symbols-outlined text-xl" aria-hidden="true">close</span>
      </button>
    </div>

    <div class="p-6 md:p-8 space-y-8">
      <div>
        <h2 id="quote-title" class="font-sora text-2xl md:text-3xl font-bold text-white mb-2">
          Calcula tu Presupuesto al Instante
        </h2>
        <p class="font-inter text-sm text-[#9CA3AF]">
          Selecciona los módulos de tu aplicación para obtener una estimación precisa de tiempo y costos.
        </p>
      </div>

      <div>
        <span class="font-technical text-xs text-[#fd625d] font-bold uppercase tracking-wider block mb-3" id="quote-type-label">
          1. Tipo de Solución Principal
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" role="group" aria-labelledby="quote-type-label">
          {
            projectTypes.map((item) => (
              <button
                type="button"
                data-project-type={item.id}
                data-label={item.label}
                data-base={item.base}
                data-weeks={item.weeks}
                aria-pressed={item.id === initialType.id ? 'true' : 'false'}
                class:list={[
                  'quote-type p-4 rounded-xl border text-left transition-all',
                  item.id === initialType.id
                    ? 'is-active bg-[#fd625d]/10 border-[#fd625d] text-white shadow-md'
                    : 'bg-[#131315] border-[#2A2A2A] text-[#9CA3AF] hover:border-[#353437]',
                ]}
              >
                <div class="font-sora font-semibold text-sm mb-1">{item.label}</div>
                <div class="font-technical text-xs text-[#fd625d]">${money(item.base)} base</div>
              </button>
            ))
          }
        </div>
      </div>

      <div class="bg-[#131315] p-5 rounded-xl border border-[#2A2A2A]">
        <div class="flex justify-between items-center mb-3">
          <label class="font-sora text-sm font-semibold text-white" for="quote-pages">
            Número estimado de páginas / vistas:
          </label>
          <span data-pages-label class="font-technical text-base font-bold text-[#edc157] px-3 py-1 rounded bg-[#2A2A2A]">
            {initialPages} páginas
          </span>
        </div>
        <input
          id="quote-pages"
          data-pages-range
          type="range"
          min="1"
          max="20"
          value={initialPages}
          class="w-full accent-[#fd625d] cursor-pointer"
        />
        <div class="flex justify-between text-[10px] font-technical text-[#9CA3AF] mt-1">
          <span>1 página (Single screen)</span>
          <span>10 páginas</span>
          <span>20+ páginas</span>
        </div>
      </div>

      <div>
        <span class="font-technical text-xs text-[#fd625d] font-bold uppercase tracking-wider block mb-3" id="quote-addons-label">
          2. Características de Ingeniería &amp; Optimización
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="group" aria-labelledby="quote-addons-label">
          {
            addons.map((addon) => (
              <label
                data-addon-label={addon.id}
                class:list={[
                  'quote-addon flex items-start justify-between p-3.5 rounded-xl border bg-[#131315] cursor-pointer transition-all',
                  addon.checked
                    ? 'is-active border-[#fd625d] text-white'
                    : 'border-[#2A2A2A] text-[#9CA3AF]',
                ]}
              >
                <div class="flex items-start gap-3">
                  <input
                    type="checkbox"
                    data-addon={addon.id}
                    data-label={addon.label}
                    data-price={addon.price}
                    checked={addon.checked}
                    class="mt-0.5 w-4 h-4 rounded border-[#353437] text-[#fd625d] focus:ring-[#fd625d]"
                  />
                  <span class="text-sm font-inter">{addon.label}</span>
                </div>
                <span class="font-technical text-xs font-bold text-[#edc157] ml-2">+${money(addon.price)}</span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="bg-[#131315] p-6 rounded-2xl border-2 border-[#fd625d]/60 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
        <div>
          <div class="font-technical text-xs text-[#9CA3AF] uppercase mb-1">
            INVERSIÓN ESTIMADA DE INGENIERÍA
          </div>
          <div class="font-sora text-3xl md:text-4xl font-bold text-white flex items-baseline gap-2">
            $<span data-quote-total>{money(initialTotal)}</span>
            <span class="text-sm font-normal text-[#9CA3AF] font-inter">USD</span>
          </div>
          <div class="text-xs font-technical text-[#58ddb0] mt-1">
            ⏱ Tiempo estimado de entrega: ~<span data-quote-weeks>{initialWeeks}</span> semanas
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <button
            type="button"
            data-quote-close
            class="px-5 py-3 rounded-full border border-[#353437] text-white font-sora text-sm hover:bg-[#2A2A2A] transition-colors text-center"
          >
            Cerrar
          </button>
          <button
            type="button"
            data-quote-whatsapp
            aria-label="Enviar la cotización por WhatsApp (se abre en una pestaña nueva)"
            class="px-6 py-3 rounded-full bg-[#fd625d] text-white font-sora text-sm font-semibold hover:scale-105 transition-all glow-coral flex items-center justify-center gap-2"
          >
            <span class="material-symbols-outlined text-lg" aria-hidden="true">send</span>
            <span>Enviar cotización por WhatsApp</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { OPEN_QUOTE_EVENT, openQuote, type OpenQuoteDetail } from '../lib/events';
  import { whatsappLink } from '../config/contact';
  import { mountAll } from '../lib/lifecycle';
  import { createModal } from '../lib/modal';

  const TYPE_ACTIVE = ['is-active', 'bg-[#fd625d]/10', 'border-[#fd625d]', 'text-white', 'shadow-md'];
  const TYPE_INACTIVE = ['bg-[#131315]', 'border-[#2A2A2A]', 'text-[#9CA3AF]'];
  const ADDON_ACTIVE = ['is-active', 'border-[#fd625d]', 'text-white'];
  const ADDON_INACTIVE = ['border-[#2A2A2A]', 'text-[#9CA3AF]'];

  const money = (value: number) => value.toLocaleString('en-US');

  // Maps the label of whatever opened the quote (service card, pricing plan...) to a project type.
  function serviceToType(service?: string): string {
    switch (service) {
      case 'E-commerce':
        return 'ecommerce';
      case 'Hardware':
        return 'hardware';
      case 'Automation':
      case 'Profesional':
        return 'webapp';
      default:
        return 'landing';
    }
  }

  function initQuoteModal(root: HTMLElement, signal: AbortSignal) {
    const pagesRange = root.querySelector<HTMLInputElement>('[data-pages-range]');
    const pagesLabel = root.querySelector<HTMLElement>('[data-pages-label]');
    const totalEl = root.querySelector<HTMLElement>('[data-quote-total]');
    const weeksEl = root.querySelector<HTMLElement>('[data-quote-weeks]');
    const typeButtons = Array.from(root.querySelectorAll<HTMLElement>('[data-project-type]'));
    const addonInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-addon]'));

    if (!pagesRange || !typeButtons.length) return;

    const pagePrice = Number(root.dataset.pagePrice);
    const priorityWeeks = Number(root.dataset.priorityWeeks);
    const modal = createModal(root, signal);

    let activeType = typeButtons[0];

    const compute = () => {
      const pages = Number(pagesRange.value);
      const checked = addonInputs.filter((input) => input.checked);
      const total =
        Number(activeType.dataset.base) +
        (pages - 1) * pagePrice +
        checked.reduce((sum, input) => sum + Number(input.dataset.price), 0);
      const weeks = checked.some((input) => input.dataset.addon === 'priority')
        ? priorityWeeks
        : Number(activeType.dataset.weeks);

      return {
        pages,
        total,
        weeks,
        typeLabel: activeType.dataset.label ?? '',
        extras: checked.map((input) => input.dataset.label ?? ''),
      };
    };

    const render = () => {
      const { pages, total, weeks } = compute();
      if (pagesLabel) pagesLabel.textContent = `${pages} ${pages === 1 ? 'página' : 'páginas'}`;
      if (totalEl) totalEl.textContent = money(total);
      if (weeksEl) weeksEl.textContent = String(weeks);
    };

    const setProjectType = (type: string) => {
      activeType = typeButtons.find((button) => button.dataset.projectType === type) ?? typeButtons[0];
      typeButtons.forEach((button) => {
        const active = button === activeType;
        button.classList.remove(...(active ? TYPE_INACTIVE : TYPE_ACTIVE));
        button.classList.add(...(active ? TYPE_ACTIVE : TYPE_INACTIVE));
        button.setAttribute('aria-pressed', String(active));
      });
      render();
    };

    const syncAddonStyles = () => {
      addonInputs.forEach((input) => {
        const label = input.closest<HTMLElement>('[data-addon-label]');
        if (!label) return;
        label.classList.remove(...(input.checked ? ADDON_INACTIVE : ADDON_ACTIVE));
        label.classList.add(...(input.checked ? ADDON_ACTIVE : ADDON_INACTIVE));
      });
    };

    const open = (service?: string) => {
      setProjectType(serviceToType(service));
      modal.open();
    };

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => setProjectType(button.dataset.projectType ?? ''), { signal });
    });

    pagesRange.addEventListener('input', render, { signal });

    addonInputs.forEach((input) => {
      input.addEventListener(
        'change',
        () => {
          syncAddonStyles();
          render();
        },
        { signal },
      );
    });

    root.querySelectorAll<HTMLElement>('[data-quote-close]').forEach((button) => {
      button.addEventListener('click', modal.close, { signal });
    });

    root.querySelector<HTMLElement>('[data-quote-whatsapp]')?.addEventListener(
      'click',
      () => {
        const { pages, total, weeks, typeLabel, extras } = compute();
        const text = [
          '¡Hola Bit & Byte Studio! Quisiera cotizar un proyecto:',
          `- Tipo: ${typeLabel}`,
          `- Páginas: ${pages}`,
          `- Extras: ${extras.length ? extras.join('; ') : 'Ninguno'}`,
          `>>> Estimación en cotizador: ~$${money(total)} USD (aprox. ${weeks} semanas)`,
        ].join('\n');

        window.open(whatsappLink(text), '_blank', 'noopener,noreferrer');
      },
      { signal },
    );

    // Single delegated trigger for every [data-open-quote] element on the page.
    document.addEventListener(
      'click',
      (event) => {
        const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-open-quote]');
        if (trigger) openQuote(trigger.getAttribute('data-open-quote') || undefined);
      },
      { signal },
    );

    window.addEventListener(
      OPEN_QUOTE_EVENT,
      (event) => open((event as CustomEvent<OpenQuoteDetail>).detail?.service),
      { signal },
    );

    syncAddonStyles();
    render();
  }

  mountAll('[data-quote-modal]', initQuoteModal);
</script>
