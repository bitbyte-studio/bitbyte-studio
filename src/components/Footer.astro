---
import {
  EMAIL,
  EMAIL_URL,
  FACEBOOK_URL,
  TELEGRAM_HANDLE,
  TELEGRAM_URL,
  WHATSAPP_DISPLAY,
  WHATSAPP_URL,
} from '../config/contact';
import { COPYRIGHT, SITE_DESCRIPTION } from '../config/site';

const legalLinks = [
  { label: 'Privacidad', href: '/privacidad' },
  { label: 'Términos', href: '/terminos' },
  { label: 'Seguridad', href: '/seguridad' },
];
---

<footer class="bg-[#1f1f21] dark:bg-[#0e0e10] border-t border-[#59413f] dark:border-[#353437] py-16 md:py-[120px] text-[#e5e1e4]">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-8 w-full px-4 md:px-6 max-w-[1280px] mx-auto">
    <div class="col-span-1 md:col-span-1">
      <div class="font-sora text-2xl md:text-3xl font-bold text-white mb-6 flex items-center gap-1.5">
        Bit <span class="ampersand text-[#fd625d]">&amp;</span> Byte
      </div>
      <p class="text-sm font-inter text-[#9CA3AF] leading-relaxed">
        {SITE_DESCRIPTION}
      </p>
    </div>

    <div>
      <h3 class="font-technical text-xs font-bold text-[#fd625d] mb-6 uppercase tracking-wider">Explora</h3>
      <ul>
        <li><a href="#inicio" class="text-[#9CA3AF] hover:text-[#fd625d] hover:translate-x-1 transition-all inline-block font-inter text-sm py-2">Inicio</a></li>
        <li><a href="#servicios" class="text-[#9CA3AF] hover:text-[#fd625d] hover:translate-x-1 transition-all inline-block font-inter text-sm py-2">Servicios y precios</a></li>
        <li><a href="#portafolio" class="text-[#9CA3AF] hover:text-[#fd625d] hover:translate-x-1 transition-all inline-block font-inter text-sm py-2">Ejemplos reales</a></li>
        <li><a href="#proceso" class="text-[#9CA3AF] hover:text-[#fd625d] hover:translate-x-1 transition-all inline-block font-inter text-sm py-2">Proceso</a></li>
        <li><a href="#contacto" class="text-[#9CA3AF] hover:text-[#fd625d] hover:translate-x-1 transition-all inline-block font-inter text-sm py-2">Contacto</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-technical text-xs font-bold text-[#fd625d] mb-6 uppercase tracking-wider">Legal</h3>
      <ul>
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[#9CA3AF] hover:text-[#fd625d] hover:translate-x-1 transition-all inline-block font-inter text-sm py-2"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="font-technical text-xs font-bold text-[#fd625d] mb-6 uppercase tracking-wider">Contacto</h3>
      <ul>
        <li>
          <a
            href={EMAIL_URL}
            aria-label={`Enviar un correo a ${EMAIL}`}
            class="text-[#9CA3AF] hover:text-[#fd625d] transition-colors font-inter text-sm break-all inline-block py-2"
          >
            {EMAIL}
          </a>
        </li>
        <li>
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp"
            data-track-source="footer"
            aria-label={`WhatsApp · ${WHATSAPP_DISPLAY} (se abre en una pestaña nueva)`}
            class="text-[#9CA3AF] hover:text-[#fd625d] transition-colors font-inter text-sm inline-block py-2"
          >
            WhatsApp · {WHATSAPP_DISPLAY}
          </a>
        </li>
        <li>
          <a
            href={TELEGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Telegram · ${TELEGRAM_HANDLE} (se abre en una pestaña nueva)`}
            class="text-[#9CA3AF] hover:text-[#fd625d] transition-colors font-inter text-sm inline-block py-2"
          >
            Telegram · {TELEGRAM_HANDLE}
          </a>
        </li>
        <li>
          <a
            href={FACEBOOK_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Bit & Byte Studio en Facebook (se abre en una pestaña nueva)"
            class="text-[#9CA3AF] hover:text-[#fd625d] transition-colors font-inter text-sm inline-block py-2"
          >
            Facebook
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-4 md:px-6 mt-16 pt-8 border-t border-[#2A2A2A] flex flex-col md:flex-row justify-between items-center gap-4">
    <p class="text-sm font-inter text-[#9CA3AF] text-center md:text-left">
      {COPYRIGHT}
    </p>
  </div>
</footer>
