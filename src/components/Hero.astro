---
import { CURRENCY, PROJECT_SERVICES } from '../config/pricing';

const cheapest = PROJECT_SERVICES.reduce((min, service) => (service.from < min.from ? service : min));
const subtitle = `Tus clientes ven tus productos desde el móvil y te piden por WhatsApp. Desde ${cheapest.from} ${CURRENCY}, listo en ${cheapest.leadTime}.`;
---

<section
  id="inicio"
  class="relative min-h-screen w-full flex flex-col items-center justify-center overflow-hidden bg-[#131315] pt-24 pb-16"
  data-hero
>
  <div class="absolute inset-0 w-full h-full opacity-40 pointer-events-none">
    <canvas data-hero-canvas class="w-full h-full block"></canvas>
  </div>

  <div class="relative z-10 text-center px-4 md:px-6 max-w-4xl mx-auto flex flex-col items-center">
    <div class="relative w-48 h-32 md:w-64 md:h-40 mb-6 flex items-center justify-center">
      <svg
        data-logo-fallback
        viewBox="0 0 330 215"
        class="absolute inset-0 w-full h-full p-3"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="0" y="115" width="100" height="100" rx="13" fill="#fd625d" />
        <rect x="121.5" y="6.5" width="87" height="87" rx="8" fill="none" stroke="#fd625d" stroke-width="13" />
        <rect x="121.5" y="121.5" width="87" height="87" rx="8" fill="none" stroke="#fd625d" stroke-width="13" />
        <rect x="230" y="0" width="100" height="100" rx="13" fill="#ffffff" />
        <rect x="230" y="115" width="100" height="100" rx="13" fill="#ffffff" />
      </svg>
      <canvas
        data-logo-canvas
        class="relative w-full h-full block"
        aria-label="Logotipo de Bit & Byte Studio"
        role="img"
      ></canvas>
    </div>

    <p class="font-technical text-xs md:text-sm text-white tracking-[0.4em] mb-3 uppercase font-bold">
      BIT <span class="ampersand font-normal tracking-normal text-[#fd625d]">&amp;</span> BYTE STUDIO
    </p>

    <p class="font-technical text-xs md:text-sm text-[#fd625d] mb-6 uppercase tracking-wider font-semibold">
      // WEBS Y SOFTWARE A MEDIDA
    </p>

    <h1 class="font-sora text-4xl sm:text-5xl md:text-[64px] text-white mb-6 leading-tight font-bold tracking-tight">
      Tu negocio en internet en <span class="text-gradient-coral">menos de una semana</span>
    </h1>

    <p class="font-inter text-base md:text-lg text-[#9CA3AF] mb-10 max-w-2xl">
      {subtitle}
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto justify-center">
      <a
        href="#portafolio"
        class="w-full sm:w-auto bg-coral-strong hover:bg-coral-strong-hover text-white px-8 py-4 rounded-full font-sora text-base font-semibold hover:scale-105 transition-all glow-coral text-center flex items-center justify-center gap-2"
      >
        <span>Ver demos</span>
        <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_downward</span>
      </a>

      <button
        type="button"
        data-open-quote
        class="w-full sm:w-auto border-2 border-white text-white px-8 py-4 rounded-full font-sora text-base font-semibold hover:bg-white hover:text-[#131315] transition-colors text-center"
      >
        Calcular presupuesto
      </button>
    </div>
  </div>

  <a
    href="#servicios"
    aria-label="Ir a servicios"
    class="absolute bottom-6 animate-bounce text-white/70 hover:text-white transition-colors"
  >
    <span class="material-symbols-outlined text-3xl" aria-hidden="true">expand_more</span>
  </a>
</section>

<script>
  import { mountAll, prefersReducedMotion } from '../lib/lifecycle';

  type Cell = { char: string; opacity: number };

  const CELL = 26;
  const GLOW_RADIUS = 120;
  const FRAME_MS = 1000 / 30;
  const BG = '#131315';

  /** Touch screens, data saver and weak CPUs get the still pattern: no loop, no pointer to follow. */
  function canAnimate() {
    if (prefersReducedMotion()) return false;
    if (window.matchMedia('(pointer: coarse)').matches) return false;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (connection?.saveData) return false;
    return (navigator.hardwareConcurrency ?? 4) >= 4;
  }

  function initHeroCanvas(canvas: HTMLCanvasElement, root: HTMLElement, signal: AbortSignal) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const animated = canAnimate();
    const base = document.createElement('canvas');
    const baseCtx = base.getContext('2d');
    if (!baseCtx) return;

    // Astro registers the font under a hashed name, so the canvas has to read it from the CSS variable.
    const family =
      getComputedStyle(document.documentElement).getPropertyValue('--font-jetbrains').trim() || 'monospace';
    const font = `700 13px ${family}`;

    let animationFrameId = 0;
    let lastFrame = 0;
    let visible = true;
    let width = 0;
    let height = 0;
    let columns = 0;
    let rows = 0;
    let grid: Cell[] = [];
    let mouseX = -1000;
    let mouseY = -1000;

    const cellX = (c: number) => c * CELL + 12;
    const cellY = (r: number) => r * CELL + 18;

    const drawBaseCell = (c: number, r: number) => {
      const cell = grid[c * rows + r];
      baseCtx.fillStyle = BG;
      baseCtx.fillRect(c * CELL, r * CELL, CELL, CELL);
      baseCtx.fillStyle = `rgba(160, 160, 160, ${cell.opacity})`;
      baseCtx.fillText(cell.char, cellX(c), cellY(r));
    };

    const paintBase = () => {
      baseCtx.fillStyle = BG;
      baseCtx.fillRect(0, 0, width, height);
      baseCtx.font = font;
      for (let c = 0; c < columns; c++) {
        for (let r = 0; r < rows; r++) drawBaseCell(c, r);
      }
    };

    const buildGrid = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth || window.innerWidth;
      height = canvas.clientHeight || window.innerHeight;
      for (const target of [canvas, base]) {
        target.width = Math.floor(width * dpr);
        target.height = Math.floor(height * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      baseCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

      columns = Math.floor(width / CELL);
      rows = Math.floor(height / CELL);
      grid = Array.from({ length: columns * rows }, () => ({
        char: Math.random() > 0.5 ? '1' : '0',
        opacity: Math.random() * 0.18 + 0.03,
      }));
      paintBase();
    };

    const flipRandomCells = () => {
      const flips = Math.max(1, Math.round(columns * rows * 0.003));
      for (let i = 0; i < flips; i++) {
        const c = Math.floor(Math.random() * columns);
        const r = Math.floor(Math.random() * rows);
        const cell = grid[c * rows + r];
        cell.char = cell.char === '1' ? '0' : '1';
        drawBaseCell(c, r);
      }
    };

    const render = () => {
      ctx.drawImage(base, 0, 0, width, height);
      ctx.font = font;

      // Only the cells under the cursor glow, so there is no need to walk the whole grid.
      const minC = Math.max(0, Math.floor((mouseX - GLOW_RADIUS) / CELL));
      const maxC = Math.min(columns - 1, Math.ceil((mouseX + GLOW_RADIUS) / CELL));
      const minR = Math.max(0, Math.floor((mouseY - GLOW_RADIUS) / CELL));
      const maxR = Math.min(rows - 1, Math.ceil((mouseY + GLOW_RADIUS) / CELL));

      for (let c = minC; c <= maxC; c++) {
        for (let r = minR; r <= maxR; r++) {
          const cell = grid[c * rows + r];
          const x = cellX(c);
          const y = cellY(r);
          const dist = Math.hypot(x - mouseX, y - mouseY);
          if (dist >= GLOW_RADIUS) continue;

          const alpha = Math.min(0.8, cell.opacity + (GLOW_RADIUS - dist) / 150);
          const color = cell.char === '1' ? '253, 98, 93' : '237, 193, 87';
          ctx.fillStyle = BG;
          ctx.fillRect(c * CELL, r * CELL, CELL, CELL);
          ctx.fillStyle = `rgba(${color}, ${alpha})`;
          ctx.fillText(cell.char, x, y);
        }
      }
    };

    const loop = (now: number) => {
      if (!visible) return;
      animationFrameId = requestAnimationFrame(loop);
      if (now - lastFrame < FRAME_MS) return;
      lastFrame = now;
      flipRandomCells();
      render();
    };

    const start = () => {
      cancelAnimationFrame(animationFrameId);
      if (animated) animationFrameId = requestAnimationFrame(loop);
      else render();
    };

    buildGrid();
    start();

    // The hashed font may still be downloading on the first paint; repaint once it is ready.
    void document.fonts.load(font).then(() => {
      if (signal.aborted) return;
      paintBase();
      render();
    });

    let resizeTimer = 0;
    window.addEventListener(
      'resize',
      () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          buildGrid();
          start();
        }, 150);
      },
      { signal },
    );

    if (animated) {
      window.addEventListener(
        'mousemove',
        (event) => {
          const rect = canvas.getBoundingClientRect();
          mouseX = event.clientX - rect.left;
          mouseY = event.clientY - rect.top;
        },
        { passive: true, signal },
      );
    }

    const observer = new IntersectionObserver(([entry]) => {
      const wasVisible = visible;
      visible = entry.isIntersecting;
      if (visible && !wasVisible && animated) start();
    });
    observer.observe(root);

    signal.addEventListener('abort', () => {
      observer.disconnect();
      window.clearTimeout(resizeTimer);
      cancelAnimationFrame(animationFrameId);
    });
  }

  function initLogo(canvas: HTMLCanvasElement, root: HTMLElement, signal: AbortSignal) {
    const fallback = root.querySelector<SVGElement>('[data-logo-fallback]');

    void import('../lib/logo3d')
      .then(({ mountLogo3D }) => {
        if (signal.aborted || !canvas.isConnected) return;
        const logo = mountLogo3D(canvas, root, () => fallback?.classList.remove('hidden'));
        if (logo.ready) fallback?.classList.add('hidden');
        signal.addEventListener('abort', () => {
          logo.dispose();
          fallback?.classList.remove('hidden');
        });
      })
      .catch(() => {});
  }

  mountAll('[data-hero]', (root, signal) => {
    const bgCanvas = root.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (bgCanvas) initHeroCanvas(bgCanvas, root, signal);

    const logoCanvas = root.querySelector<HTMLCanvasElement>('[data-logo-canvas]');
    if (logoCanvas) initLogo(logoCanvas, root, signal);
  });
</script>
