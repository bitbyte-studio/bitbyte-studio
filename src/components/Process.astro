---
import { PROCESS_STEPS } from '../data';
---

<section id="proceso" class="surface-light bg-[#F7F5F2] py-20 md:py-[120px] scroll-mt-24">
  <div class="max-w-[1280px] mx-auto px-4 md:px-6">
    <div class="mb-14 md:mb-16 text-center flex flex-col items-center">
      <p class="font-technical text-sm font-bold text-coral-ink mb-2 uppercase tracking-widest">proceso</p>
      <h2 class="font-sora text-3xl md:text-4xl lg:text-[40px] font-bold text-[#1A1A1A]">Cómo trabajamos</h2>
      <p class="font-inter text-sm text-[#5B5B5E] mt-3 max-w-lg">
        Así trabajamos de principio a fin, paso a paso.
      </p>
    </div>

    <ol class="relative grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-6">
      <li class="hidden lg:block absolute top-6 left-[10%] right-[10%] h-0.5 bg-[#E5E0D8]" aria-hidden="true"></li>
      <li class="lg:hidden absolute top-6 bottom-6 left-6 w-0.5 bg-[#E5E0D8]" aria-hidden="true"></li>

      {
        PROCESS_STEPS.map((item) => (
          <li class="relative flex lg:flex-col items-start lg:items-center gap-5 lg:gap-0 lg:text-center">
            <div class="w-12 h-12 shrink-0 rounded-full flex items-center justify-center font-sora font-bold text-lg lg:mb-5 bg-coral-strong text-white shadow-md ring-4 ring-[#F7F5F2]">
              {item.step}
            </div>
            <div>
              <h3 class="font-sora text-xl font-bold text-[#1A1A1A] mb-2">{item.title}</h3>
              <p class="text-sm font-inter font-medium text-[#1A1A1A] leading-relaxed mb-2">{item.description}</p>
              <p class="text-sm font-inter text-[#4A4A4A] leading-relaxed">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
