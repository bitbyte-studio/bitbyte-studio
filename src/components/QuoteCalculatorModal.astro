---
import {
  CURRENCY,
  CURRENCY_NOTE,
  DOMAIN_OPTION,
  EXTRAS,
  HOSTING_OPTIONS,
  MAINTENANCE,
  PROJECT_SERVICES,
  QUOTE_SETUP,
} from '../config/pricing';
import { calculateQuote, publishingOptionPrice } from '../lib/quote';

const money = (value: number) => value.toLocaleString('en-US');
const annualMonthly = MAINTENANCE.annualFrom ?? MAINTENANCE.from;
const maintenanceOptions = [
  { id: 'none', name: 'No por ahora', price: '' },
  { id: 'monthly', name: 'Sí, con pago mensual', price: `${money(MAINTENANCE.from)} ${CURRENCY}${MAINTENANCE.suffix ?? ''}` },
  {
    id: 'annual',
    name: 'Sí, con pago anual',
    price: `${money(annualMonthly)} ${CURRENCY}${MAINTENANCE.suffix ?? ''} · ${money(annualMonthly * 12)} ${CURRENCY} al año`,
  },
] as const;
const includes = (MAINTENANCE.includes ?? []).map((item) => item.charAt(0).toLowerCase() + item.slice(1));
const maintenanceIncludes =
  includes.length > 1 ? `${includes.slice(0, -1).join(', ')} y ${includes[includes.length - 1]}` : includes[0];
const freeAddress = HOSTING_OPTIONS.find((option) => option.price === 0)?.description;

const initialService = PROJECT_SERVICES[0];
const initialSetup = QUOTE_SETUP[initialService.id];
const initialQuote = calculateQuote(initialService.id);

const stepTitle = 'block font-sora text-base md:text-lg font-semibold text-white mb-3';
const row = 'p-3.5 rounded-xl border bg-[#131315] border-[#2A2A2A] text-[#9CA3AF] transition-all';
const control = 'w-4 h-4 shrink-0 border-[#353437] text-[#fd625d] focus:ring-[#fd625d]';
const priceTag = 'font-inter text-xs font-semibold text-[#edc157] text-right shrink-0';
---

<div
  data-quote-modal
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fadeIn hidden"
  hidden
>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="quote-title"
    tabindex="-1"
    class="scrollbar-dark bg-[#1A1A1A] border border-[#353437] rounded-2xl w-full max-w-3xl max-h-[92vh] overflow-y-auto shadow-2xl text-white outline-none"
  >
    <div class="sticky top-0 bg-[#1A1A1A]/95 backdrop-blur-md border-b border-[#2A2A2A] px-6 py-4 flex items-center justify-between gap-4 z-10">
      <h2 id="quote-title" class="font-sora text-xl md:text-2xl font-bold text-white">Calcula un estimado</h2>
      <button
        type="button"
        data-quote-close
        class="w-8 h-8 shrink-0 rounded-full bg-[#2A2A2A] hover:bg-[#353437] flex items-center justify-center text-[#9CA3AF] hover:text-white transition-colors"
        aria-label="Cerrar cotizador"
      >
        <span class="material-symbols-outlined text-xl" aria-hidden="true">close</span>
      </button>
    </div>

    <div class="p-6 md:p-8 space-y-8">
      <p class="font-inter text-sm text-[#9CA3AF]">
        Responde estas preguntas y te mostramos un precio de partida. El precio final lo confirmamos contigo por WhatsApp.
      </p>

      <div>
        <h3 id="quote-service-label" class={stepTitle}>¿Qué necesitas?</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="group" aria-labelledby="quote-service-label">
          {
            PROJECT_SERVICES.map((service) => (
              <button
                type="button"
                data-service={service.id}
                aria-pressed={service.id === initialService.id ? 'true' : 'false'}
                class:list={[
                  'quote-service p-4 rounded-xl border text-left transition-all',
                  service.id === initialService.id
                    ? 'is-active bg-[#fd625d]/10 border-[#fd625d] text-white shadow-md'
                    : 'bg-[#131315] border-[#2A2A2A] text-[#9CA3AF] hover:border-[#353437]',
                ]}
              >
                <span class="block font-sora font-semibold text-sm mb-1">{service.name}</span>
                <span class="block font-inter text-xs text-[#9CA3AF] leading-relaxed mb-2">{service.description}</span>
                <span class="block font-inter text-sm font-semibold text-[#ffb3ad]">
                  desde {money(service.from)} {CURRENCY}
                  {service.suffix ? ` · ${service.suffix}` : ''}
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div data-extras-step class:list={[initialSetup.extras.length === 0 && 'hidden']} hidden={initialSetup.extras.length === 0}>
        <h3 id="quote-extras-label" class={stepTitle}>
          ¿Algo más? <span class="font-inter text-sm font-normal text-[#9CA3AF]">(opcional)</span>
        </h3>
        <div class="grid grid-cols-1 gap-3" role="group" aria-labelledby="quote-extras-label">
          {
            EXTRAS.map((extra) => {
              const offered = initialSetup.extras.some((id) => id === extra.id);
              return (
                <div
                  data-extra-row={extra.id}
                  hidden={!offered}
                  class:list={['quote-extra flex flex-wrap items-center justify-between gap-3', row, !offered && 'hidden']}
                >
                  <label class="flex items-center gap-3 cursor-pointer flex-1 min-w-[12rem]">
                    <input type="checkbox" data-extra={extra.id} class:list={[control, 'rounded']} />
                    <span class="text-sm font-inter">{extra.name}</span>
                  </label>

                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    {extra.quantity && (
                      <label class="flex items-center gap-2 text-xs font-inter">
                        <span>{extra.quantity.label}</span>
                        <input
                          type="number"
                          inputmode="numeric"
                          data-extra-qty={extra.id}
                          min="1"
                          max={extra.quantity.max}
                          value="1"
                          disabled
                          class="w-20 bg-[#1A1A1A] border border-[#353437] rounded-lg px-2 py-1 text-white text-center disabled:opacity-40"
                        />
                      </label>
                    )}
                    <span class:list={[priceTag, 'whitespace-nowrap']}>
                      {extra.price === undefined
                        ? 'precio a consultar'
                        : `+${money(extra.price)} ${CURRENCY}${extra.unit ? ` ${extra.unit}` : ''}`}
                    </span>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>

      <fieldset data-domain-step class:list={[!initialSetup.domain && 'hidden']} hidden={!initialSetup.domain}>
        <legend class={stepTitle}>¿Quieres tu propio nombre en internet?</legend>
        <div class="grid grid-cols-1 gap-3">
          <label data-domain-row class:list={['flex items-start gap-3 cursor-pointer', row]}>
            <input type="radio" name="quote-domain" value="no" data-domain checked class:list={[control, 'mt-0.5']} />
            <span>
              <span class="block text-sm font-inter">No por ahora</span>
              {freeAddress && (
                <span data-free-address class="block text-xs font-inter opacity-80 mt-0.5">
                  Tu web queda en una dirección gratuita, tipo {freeAddress}.
                </span>
              )}
            </span>
          </label>
          <label data-domain-row class:list={['flex items-start justify-between gap-3 cursor-pointer', row]}>
            <span class="flex items-start gap-3">
              <input type="radio" name="quote-domain" value="yes" data-domain class:list={[control, 'mt-0.5']} />
              <span>
                <span class="block text-sm font-inter">Sí, quiero mi dominio propio .com</span>
                <span class="block text-xs font-inter opacity-80 mt-0.5">
                  Por ejemplo, tunegocio.com. Nosotros lo registramos y lo gestionamos.
                </span>
              </span>
            </span>
            <span class:list={[priceTag, 'whitespace-nowrap']}>{publishingOptionPrice(DOMAIN_OPTION, initialService.id)}</span>
          </label>
        </div>
        <p data-hosting-note class="mt-3 font-inter text-xs text-[#9CA3AF]"></p>
      </fieldset>

      <fieldset>
        <legend class={stepTitle}>¿Quieres mantenimiento después de la entrega?</legend>
        {maintenanceIncludes && <p class="-mt-1 mb-3 font-inter text-xs text-[#9CA3AF]">Incluye {maintenanceIncludes}.</p>}
        <div class="grid grid-cols-1 gap-3">
          {
            maintenanceOptions.map((option) => (
              <label data-maintenance-row={option.id} class:list={['flex items-start justify-between gap-3 cursor-pointer', row]}>
                <span class="flex items-start gap-3">
                  <input
                    type="radio"
                    name="quote-maintenance"
                    value={option.id}
                    data-maintenance={option.id}
                    checked={option.id === 'none'}
                    class:list={[control, 'mt-0.5']}
                  />
                  <span class="text-sm font-inter">{option.name}</span>
                </span>
                {option.price && (
                  <span class={priceTag}>
                    {option.price.split(' · ').map((part, index, parts) => (
                      <>
                        <span class="whitespace-nowrap">{index < parts.length - 1 ? `${part} ·` : part}</span>
                        {index < parts.length - 1 && ' '}
                      </>
                    ))}
                  </span>
                )}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="bg-[#131315] p-6 rounded-2xl border border-[#2A2A2A] space-y-5">
        <div>
          <h3 class="font-sora text-sm font-semibold text-white mb-2">Pago único</h3>
          <ul data-quote-once class="space-y-1.5 text-sm font-inter text-[#e5e1e4]"></ul>
          <p class="mt-3 pt-3 border-t border-[#2A2A2A] flex justify-between gap-4 text-sm font-inter font-semibold text-white">
            <span>Total</span>
            <span>desde <span data-quote-total>{money(initialQuote.oneTime)}</span> {CURRENCY}</span>
          </p>
          <p class="text-xs font-inter text-[#58ddb0] mt-2">
            Plazo orientativo: <span data-quote-leadtime>{initialQuote.leadTime}</span>
          </p>
        </div>

        <div class="border-t border-[#2A2A2A] pt-4">
          <h3 class="font-sora text-sm font-semibold text-white mb-2">Pagos mensuales o anuales</h3>
          <ul data-quote-recurring class="space-y-1.5 text-sm font-inter text-[#e5e1e4]"></ul>
          <ul data-quote-recurring-totals class="mt-2 pt-2 border-t border-[#2A2A2A] space-y-1 text-sm font-inter font-semibold text-white hidden" hidden></ul>
          <p data-quote-empty class="text-sm font-inter text-[#9CA3AF] hidden" hidden>No tienes pagos mensuales ni anuales.</p>
        </div>

        <p class="text-xs font-inter text-[#9CA3AF]">El precio final lo confirmamos por WhatsApp. {CURRENCY_NOTE}</p>
      </div>
    </div>

    <div class="sticky bottom-0 z-10 bg-[#1A1A1A]/95 backdrop-blur-md border-t border-[#2A2A2A] px-6 py-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <div aria-live="polite">
        <p class="font-inter text-sm text-[#9CA3AF] flex items-baseline gap-1.5">
          <span>Pago único desde</span>
          <span data-bar-total class="font-sora text-2xl font-bold text-white">{money(initialQuote.oneTime)}</span>
          <span>{CURRENCY}</span>
        </p>
        <p class="font-inter text-xs text-[#9CA3AF]">
          <span data-bar-later></span> · Plazo: <span data-bar-leadtime>{initialQuote.leadTime}</span>
        </p>
      </div>
      <button
        type="button"
        data-quote-whatsapp
        aria-label="Enviar el estimado por WhatsApp (se abre en una pestaña nueva)"
        class="w-full sm:w-auto px-6 py-3 rounded-full bg-coral-strong hover:bg-coral-strong-hover text-white font-sora text-sm font-semibold transition-colors glow-coral flex items-center justify-center gap-2"
      >
        <span class="material-symbols-outlined text-lg" aria-hidden="true">send</span>
        <span>Enviar por WhatsApp</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { OPEN_QUOTE_EVENT, openQuote, type OpenQuoteDetail } from '../lib/events';
  import { whatsappLink } from '../config/contact';
  import { mountTracking, track } from '../lib/analytics';
  import {
    HOSTING_OPTIONS,
    PROJECT_SERVICES,
    QUOTE_SETUP,
    type ExtraId,
    type ProjectServiceId,
    type PublishingOption,
  } from '../config/pricing';
  import {
    calculateQuote,
    clampQuantity,
    formatLineAmount,
    lineLabel,
    oneTimeLines,
    publishingOptionPrice,
    publishingPriceFor,
    quoteToMessage,
    recurringLines,
    recurringTotals,
    type MaintenanceMode,
    type Quote,
    type QuoteExtraInput,
    type QuoteLine,
  } from '../lib/quote';
  import { mountAll } from '../lib/lifecycle';
  import { createModal, setVisible } from '../lib/modal';

  const SERVICE_ACTIVE = ['is-active', 'bg-[#fd625d]/10', 'border-[#fd625d]', 'text-white', 'shadow-md'];
  const SERVICE_INACTIVE = ['bg-[#131315]', 'border-[#2A2A2A]', 'text-[#9CA3AF]'];
  const ROW_ACTIVE = ['border-[#fd625d]', 'text-white'];
  const ROW_INACTIVE = ['border-[#2A2A2A]', 'text-[#9CA3AF]'];

  const isServiceId = (value: string | undefined): value is ProjectServiceId =>
    PROJECT_SERVICES.some((service) => service.id === value);

  const isMaintenanceMode = (value: string | undefined): value is MaintenanceMode =>
    value === 'none' || value === 'monthly' || value === 'annual';

  function lineItem(line: QuoteLine): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'flex justify-between gap-4';
    const label = document.createElement('span');
    label.textContent = lineLabel(line);
    const amount = document.createElement('span');
    amount.className = 'text-xs font-semibold text-[#edc157] whitespace-nowrap';
    amount.textContent = formatLineAmount(line);
    li.append(label, amount);
    return li;
  }

  function laterSummary(quote: Quote): string {
    const parts: string[] = [];
    if (quote.monthly > 0) {
      parts.push(formatLineAmount({ amount: quote.monthly, billing: 'monthly', from: quote.monthlyFrom }));
    }
    if (quote.yearly > 0) {
      parts.push(formatLineAmount({ amount: quote.yearly, billing: 'yearly', from: quote.yearlyFrom }));
    }
    if (recurringLines(quote).some((line) => line.amount === null)) parts.push('a consultar');
    return parts.length ? `Además: ${parts.join(' + ')}` : 'Sin pagos mensuales ni anuales';
  }

  function hostingNote(option: PublishingOption, serviceId: ProjectServiceId): string {
    const { amount } = publishingPriceFor(option, serviceId);
    if (amount === 0) return 'El alojamiento es gratis.';
    if (amount === null) return 'El precio del alojamiento te lo confirmamos por WhatsApp.';
    return `El alojamiento cuesta ${publishingOptionPrice(option, serviceId)} y se paga aparte.`;
  }

  function initQuoteModal(root: HTMLElement, signal: AbortSignal) {
    const serviceButtons = Array.from(root.querySelectorAll<HTMLElement>('[data-service]'));
    const extraInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-extra]'));
    const domainInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-domain]'));
    const maintenanceInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-maintenance]'));
    const extrasStep = root.querySelector<HTMLElement>('[data-extras-step]');
    const domainStep = root.querySelector<HTMLElement>('[data-domain-step]');
    const freeAddressEl = root.querySelector<HTMLElement>('[data-free-address]');
    const hostingNoteEl = root.querySelector<HTMLElement>('[data-hosting-note]');
    const totalEl = root.querySelector<HTMLElement>('[data-quote-total]');
    const leadTimeEl = root.querySelector<HTMLElement>('[data-quote-leadtime]');
    const onceEl = root.querySelector<HTMLElement>('[data-quote-once]');
    const recurringEl = root.querySelector<HTMLElement>('[data-quote-recurring]');
    const recurringTotalsEl = root.querySelector<HTMLElement>('[data-quote-recurring-totals]');
    const emptyEl = root.querySelector<HTMLElement>('[data-quote-empty]');
    const barTotalEl = root.querySelector<HTMLElement>('[data-bar-total]');
    const barLaterEl = root.querySelector<HTMLElement>('[data-bar-later]');
    const barLeadTimeEl = root.querySelector<HTMLElement>('[data-bar-leadtime]');

    if (!serviceButtons.length || !maintenanceInputs.length || !domainInputs.length) return;

    const modal = createModal(root, signal);
    let serviceId: ProjectServiceId = PROJECT_SERVICES[0].id;

    const setup = () => QUOTE_SETUP[serviceId];
    const offersExtra = (id: string) => setup().extras.some((extra) => extra === id);
    const qtyInput = (id: string) => root.querySelector<HTMLInputElement>(`[data-extra-qty="${id}"]`);

    const selectedExtras = (): QuoteExtraInput[] =>
      extraInputs
        .filter((input) => input.checked && offersExtra(input.dataset.extra ?? ''))
        .map((input) => {
          const id = input.dataset.extra as ExtraId;
          const qty = qtyInput(id);
          return { id, quantity: qty ? Number(qty.value) : undefined };
        });

    const wantsDomain = () => setup().domain && domainInputs.some((input) => input.checked && input.value === 'yes');

    const selectedMaintenance = (): MaintenanceMode => {
      const value = maintenanceInputs.find((input) => input.checked)?.value;
      return isMaintenanceMode(value) ? value : 'none';
    };

    const currentQuote = () =>
      calculateQuote(serviceId, selectedExtras(), {
        maintenance: selectedMaintenance(),
        publishing: { hosting: setup().hosting ?? undefined, domain: wantsDomain() },
      });

    // Rewrites a quantity input with the same clamped integer that calculateQuote uses.
    const normalizeQuantity = (input: HTMLInputElement) => {
      const max = Number(input.max);
      const value = clampQuantity(input.value === '' ? undefined : Number(input.value), max);
      input.value = String(value);
    };

    const paintRow = (el: HTMLElement | null, active: boolean) => {
      if (!el) return;
      el.classList.remove(...(active ? ROW_INACTIVE : ROW_ACTIVE));
      el.classList.add(...(active ? ROW_ACTIVE : ROW_INACTIVE));
    };

    const render = () => {
      const { extras, hosting, domain } = setup();

      setVisible(extrasStep, extras.length > 0);
      extraInputs.forEach((input) => {
        const id = input.dataset.extra ?? '';
        const row = input.closest<HTMLElement>('[data-extra-row]');
        const qty = qtyInput(id);
        if (qty) qty.disabled = !input.checked;
        setVisible(row, offersExtra(id));
        paintRow(row, input.checked);
      });

      setVisible(domainStep, domain);
      const hostingOption = HOSTING_OPTIONS.find((option) => option.id === hosting);
      setVisible(freeAddressEl, !!hostingOption && publishingPriceFor(hostingOption, serviceId).amount === 0);
      if (hostingNoteEl) hostingNoteEl.textContent = hostingOption ? hostingNote(hostingOption, serviceId) : '';
      domainInputs.forEach((input) => {
        paintRow(input.closest<HTMLElement>('[data-domain-row]'), input.checked);
      });
      maintenanceInputs.forEach((input) => {
        paintRow(input.closest<HTMLElement>('[data-maintenance-row]'), input.checked);
      });

      const quote = currentQuote();
      const total = quote.oneTime.toLocaleString('en-US');
      if (totalEl) totalEl.textContent = total;
      if (barTotalEl) barTotalEl.textContent = total;
      if (leadTimeEl) leadTimeEl.textContent = quote.leadTime;
      if (barLeadTimeEl) barLeadTimeEl.textContent = quote.leadTime;
      if (barLaterEl) barLaterEl.textContent = laterSummary(quote);
      onceEl?.replaceChildren(...oneTimeLines(quote).map(lineItem));

      const recurring = recurringLines(quote);
      recurringEl?.replaceChildren(...recurring.map(lineItem));
      const totals = recurringTotals(quote);
      recurringTotalsEl?.replaceChildren(
        ...totals.map((text) => {
          const li = document.createElement('li');
          li.textContent = text;
          return li;
        }),
      );
      setVisible(recurringTotalsEl, totals.length > 0);
      setVisible(emptyEl, recurring.length === 0);
    };

    const setService = (id: ProjectServiceId) => {
      serviceId = id;
      serviceButtons.forEach((button) => {
        const active = button.dataset.service === id;
        button.classList.remove(...(active ? SERVICE_INACTIVE : SERVICE_ACTIVE));
        button.classList.add(...(active ? SERVICE_ACTIVE : SERVICE_INACTIVE));
        button.setAttribute('aria-pressed', String(active));
      });
      render();
    };

    const open = (service?: string) => {
      setService(isServiceId(service) ? service : serviceId);
      modal.open();
    };

    serviceButtons.forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          const id = button.dataset.service;
          if (isServiceId(id)) setService(id);
        },
        { signal },
      );
    });

    [...extraInputs, ...domainInputs, ...maintenanceInputs].forEach((input) => {
      input.addEventListener('change', render, { signal });
    });
    root.querySelectorAll<HTMLInputElement>('[data-extra-qty]').forEach((input) => {
      input.addEventListener('input', render, { signal });
      const commit = () => {
        normalizeQuantity(input);
        render();
      };
      input.addEventListener('change', commit, { signal });
      input.addEventListener('blur', commit, { signal });
    });

    root.querySelectorAll<HTMLElement>('[data-quote-close]').forEach((button) => {
      button.addEventListener('click', modal.close, { signal });
    });

    root.querySelector<HTMLElement>('[data-quote-whatsapp]')?.addEventListener(
      'click',
      () => {
        track('whatsapp_click', { source: 'cotizador', service: serviceId });
        window.open(whatsappLink(quoteToMessage(currentQuote())), '_blank', 'noopener,noreferrer');
      },
      { signal },
    );

    // Single delegated trigger for every [data-open-quote] element on the page.
    document.addEventListener(
      'click',
      (event) => {
        const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-open-quote]');
        if (trigger) openQuote(trigger.getAttribute('data-open-quote') || undefined);
      },
      { signal },
    );

    mountTracking(signal);

    window.addEventListener(
      OPEN_QUOTE_EVENT,
      (event) => {
        const requested = (event as CustomEvent<OpenQuoteDetail>).detail?.service;
        track('quote_open', { service: requested });
        open(requested);
      },
      { signal },
    );

    setService(serviceId);
  }

  mountAll('[data-quote-modal]', initQuoteModal);
</script>
