---
import { PROJECTS } from '../data';

const filters = [
  { label: 'Todos', value: 'all' },
  { label: 'Web Dev', value: 'web' },
  { label: 'E-commerce', value: 'ecommerce' },
  { label: '3D / Interactivo', value: 'interactive' },
] as const;
---

<section id="portafolio" class="bg-[#131315] py-20 md:py-[120px]" data-portfolio>
  <div class="max-w-[1280px] mx-auto px-4 md:px-6">
    <div class="mb-12 text-center flex flex-col items-center">
      <p class="font-technical text-sm font-bold text-[#fd625d] mb-2 uppercase tracking-widest">// portafolio</p>
      <h2 class="font-sora text-3xl md:text-4xl lg:text-[40px] font-bold text-white mb-6">
        Nuestros Proyectos
      </h2>

      <div class="flex flex-wrap items-center justify-center gap-2 bg-[#1A1A1A] p-1.5 rounded-full border border-[#2A2A2A]">
        {
          filters.map((item) => (
            <button
              type="button"
              data-filter={item.value}
              class:list={[
                'portfolio-filter px-4 py-1.5 rounded-full font-sora text-xs font-semibold transition-all',
                item.value === 'all'
                  ? 'is-active bg-[#fd625d] text-white shadow-md'
                  : 'text-[#9CA3AF] hover:text-white',
              ]}
            >
              {item.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col gap-16 md:gap-24" data-project-list>
      {
        PROJECTS.map((project, index) => {
          const isEven = index % 2 === 1;
          return (
            <article
              data-project-item
              data-category={project.category}
              data-project-id={project.id}
              class="project-item grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center"
            >
              <div class:list={[isEven ? 'order-1 lg:order-2' : 'order-2 lg:order-1']}>
                <div class="flex items-center gap-3 mb-3">
                  <span class="w-2 h-2 rounded-full bg-[#58ddb0]"></span>
                  <span class="font-technical text-xs text-[#9CA3AF] uppercase tracking-wider">
                    CLIENTE: {project.client || 'Bit & Byte Partner'} · {project.year || '2025'}
                  </span>
                </div>

                <h3 class="font-sora text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-4">
                  {project.title}
                </h3>
                <p class="font-inter text-base md:text-lg text-[#9CA3AF] mb-6 leading-relaxed">
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-2 mb-8">
                  {project.tags.map((tag) => (
                    <span class="px-3 py-1 bg-[#fd625d]/10 border border-[#fd625d]/40 text-[#fd625d] rounded-full text-xs font-technical uppercase tracking-wider">
                      {tag}
                    </span>
                  ))}
                </div>

                {project.metrics && (
                  <div class="grid grid-cols-3 gap-3 mb-8 p-4 rounded-xl bg-[#1A1A1A] border border-[#2A2A2A]">
                    {project.metrics.map((metric) => (
                      <div class="text-center">
                        <div class="font-sora text-base md:text-lg font-bold text-[#edc157]">{metric.value}</div>
                        <div class="font-technical text-[10px] text-[#9CA3AF] uppercase mt-0.5">{metric.label}</div>
                      </div>
                    ))}
                  </div>
                )}

                <button
                  type="button"
                  data-open-project={project.id}
                  class="text-white font-technical text-sm uppercase tracking-wider inline-flex items-center gap-2 hover:text-[#fd625d] transition-colors group cursor-pointer"
                >
                  <span>VER PROYECTO</span>
                  <span class="material-symbols-outlined text-lg group-hover:translate-x-2 transition-transform">
                    arrow_forward
                  </span>
                </button>
              </div>

              <div
                role="button"
                tabindex="0"
                data-open-project={project.id}
                class:list={[
                  'rounded-2xl overflow-hidden border border-[#2A2A2A] group cursor-pointer bg-[#1A1A1A] relative',
                  isEven ? 'order-2 lg:order-1' : 'order-1 lg:order-2',
                ]}
              >
                <img
                  src={project.image}
                  alt={project.title}
                  referrerpolicy="no-referrer"
                  class="w-full h-[320px] sm:h-[380px] lg:h-[400px] object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                  <span class="px-5 py-2.5 rounded-full bg-[#fd625d] text-white font-sora text-sm font-semibold glow-coral flex items-center gap-2">
                    <span class="material-symbols-outlined text-base">open_in_new</span>
                    Explorar Estudio de Caso
                  </span>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { PROJECTS } from '../data';
  import { openProject } from '../lib/events';

  function initPortfolio(root: HTMLElement) {
    const filters = Array.from(root.querySelectorAll<HTMLElement>('[data-filter]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-project-item]'));

    const setFilter = (value: string) => {
      filters.forEach((button) => {
        const active = button.dataset.filter === value;
        button.classList.toggle('is-active', active);
        button.classList.toggle('bg-[#fd625d]', active);
        button.classList.toggle('text-white', active);
        button.classList.toggle('shadow-md', active);
        button.classList.toggle('text-[#9CA3AF]', !active);
      });

      const visible = items.filter((item) => value === 'all' || item.dataset.category === value);

      items.forEach((item) => {
        const show = visible.includes(item);
        item.classList.toggle('hidden', !show);
        item.hidden = !show;
      });

      visible.forEach((item, index) => {
        const isEven = index % 2 === 1;
        const textCol = item.children[0] as HTMLElement | undefined;
        const imageCol = item.children[1] as HTMLElement | undefined;
        if (!textCol || !imageCol) return;

        textCol.classList.toggle('order-1', isEven);
        textCol.classList.toggle('lg:order-2', isEven);
        textCol.classList.toggle('order-2', !isEven);
        textCol.classList.toggle('lg:order-1', !isEven);

        imageCol.classList.toggle('order-2', isEven);
        imageCol.classList.toggle('lg:order-1', isEven);
        imageCol.classList.toggle('order-1', !isEven);
        imageCol.classList.toggle('lg:order-2', !isEven);
      });
    };

    filters.forEach((button) => {
      button.addEventListener('click', () => setFilter(button.dataset.filter || 'all'));
    });

    root.querySelectorAll<HTMLElement>('[data-open-project]').forEach((el) => {
      if (el.dataset.bound === 'true') return;
      el.dataset.bound = 'true';

      const open = () => {
        const id = el.dataset.openProject;
        const project = PROJECTS.find((item) => item.id === id);
        if (project) openProject(project);
      };

      el.addEventListener('click', open);
      el.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open();
        }
      });
    });
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-portfolio]').forEach(initPortfolio);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
