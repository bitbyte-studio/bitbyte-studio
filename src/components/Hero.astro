---
import { SITE_DESCRIPTION } from '../config/site';
---

<section
  id="inicio"
  class="relative min-h-screen w-full flex flex-col items-center justify-center overflow-hidden bg-[#131315] pt-24 pb-16"
  data-hero
>
  <div class="absolute inset-0 w-full h-full opacity-40 pointer-events-none">
    <canvas data-hero-canvas class="w-full h-full block"></canvas>
  </div>

  <div class="relative z-10 text-center px-4 md:px-6 max-w-4xl mx-auto flex flex-col items-center">
    <div class="w-48 h-32 md:w-64 md:h-40 mb-6 flex items-center justify-center">
      <canvas
        data-logo-canvas
        class="w-full h-full block"
        aria-label="Bit & Byte Studio logo"
        role="img"
      ></canvas>
    </div>

    <p class="font-technical text-xs md:text-sm text-white tracking-[0.4em] mb-3 uppercase font-bold">
      BIT <span class="ampersand font-normal tracking-normal text-[#fd625d]">&amp;</span> BYTE STUDIO
    </p>

    <p class="font-technical text-xs md:text-sm text-[#fd625d] mb-6 uppercase tracking-wider font-semibold">
      // WEBS Y SOFTWARE A MEDIDA
    </p>

    <h1 class="font-sora text-4xl sm:text-5xl md:text-[64px] text-white mb-6 leading-tight font-bold tracking-tight">
      Convertimos ideas en <span class="text-gradient-coral">tecnología</span>
    </h1>

    <p class="font-inter text-base md:text-lg text-[#9CA3AF] mb-10 max-w-2xl">
      {SITE_DESCRIPTION}
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto justify-center">
      <a
        href="#portafolio"
        class="w-full sm:w-auto bg-[#fd625d] text-white px-8 py-4 rounded-full font-sora text-base font-semibold hover:scale-105 transition-all glow-coral text-center flex items-center justify-center gap-2"
      >
        <span>Ver portafolio</span>
        <span class="material-symbols-outlined text-sm">arrow_downward</span>
      </a>

      <button
        type="button"
        data-open-quote
        class="w-full sm:w-auto border-2 border-white text-white px-8 py-4 rounded-full font-sora text-base font-semibold hover:bg-white hover:text-[#131315] transition-colors text-center"
      >
        Cotizar proyecto
      </button>
    </div>
  </div>

  <a
    href="#servicios"
    aria-label="Ir a servicios"
    class="absolute bottom-6 animate-bounce text-white/70 hover:text-white transition-colors"
  >
    <span class="material-symbols-outlined text-3xl">expand_more</span>
  </a>
</section>

<script>
  import { mountAll, prefersReducedMotion } from '../lib/lifecycle';

  type Cell = { char: string; opacity: number };

  const CELL = 26;

  function initHeroCanvas(canvas: HTMLCanvasElement, root: HTMLElement, signal: AbortSignal) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = prefersReducedMotion();
    let animationFrameId = 0;
    let visible = true;
    let width = 0;
    let height = 0;
    let columns = 0;
    let rows = 0;
    let grid: Cell[] = [];
    let mouseX = -1000;
    let mouseY = -1000;

    const buildGrid = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth || window.innerWidth;
      height = canvas.clientHeight || window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      columns = Math.floor(width / CELL);
      rows = Math.floor(height / CELL);
      grid = Array.from({ length: columns * rows }, () => ({
        char: Math.random() > 0.5 ? '1' : '0',
        opacity: Math.random() * 0.18 + 0.03,
      }));
    };

    const render = () => {
      ctx.fillStyle = '#131315';
      ctx.fillRect(0, 0, width, height);
      ctx.font = '700 13px "JetBrains Mono", monospace';

      for (let c = 0; c < columns; c++) {
        for (let r = 0; r < rows; r++) {
          const cell = grid[c * rows + r];
          const x = c * CELL + 12;
          const y = r * CELL + 18;
          const dist = Math.hypot(x - mouseX, y - mouseY);

          let alpha = cell.opacity;
          let color = '160, 160, 160';

          if (dist < 120) {
            alpha = Math.min(0.8, cell.opacity + (120 - dist) / 150);
            color = cell.char === '1' ? '253, 98, 93' : '237, 193, 87';
          }

          ctx.fillStyle = `rgba(${color}, ${alpha})`;
          ctx.fillText(cell.char, x, y);

          if (!reduceMotion && Math.random() < 0.003) {
            cell.char = cell.char === '1' ? '0' : '1';
          }
        }
      }
    };

    const loop = () => {
      if (!visible) return;
      render();
      animationFrameId = requestAnimationFrame(loop);
    };

    const start = () => {
      cancelAnimationFrame(animationFrameId);
      if (reduceMotion) render();
      else loop();
    };

    buildGrid();
    start();

    window.addEventListener(
      'resize',
      () => {
        buildGrid();
        start();
      },
      { signal },
    );

    if (!reduceMotion) {
      window.addEventListener(
        'mousemove',
        (event) => {
          const rect = canvas.getBoundingClientRect();
          mouseX = event.clientX - rect.left;
          mouseY = event.clientY - rect.top;
        },
        { passive: true, signal },
      );
    }

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !reduceMotion) start();
    });
    observer.observe(root);

    signal.addEventListener('abort', () => {
      observer.disconnect();
      cancelAnimationFrame(animationFrameId);
    });
  }

  function initLogo(canvas: HTMLCanvasElement, root: HTMLElement, signal: AbortSignal) {
    void import('../lib/logo3d').then(({ mountLogo3D }) => {
      if (signal.aborted || !canvas.isConnected) return;
      const logo = mountLogo3D(canvas, root);
      signal.addEventListener('abort', logo.dispose);
    });
  }

  mountAll('[data-hero]', (root, signal) => {
    const bgCanvas = root.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (bgCanvas) initHeroCanvas(bgCanvas, root, signal);

    const logoCanvas = root.querySelector<HTMLCanvasElement>('[data-logo-canvas]');
    if (logoCanvas) initLogo(logoCanvas, root, signal);
  });
</script>
