---
import { SERVICE_DETAILS } from '../data';
import { whatsappLink } from '../config/contact';
import {
  CURRENCY,
  CURRENCY_NOTE,
  DOMAIN_OPTION,
  HOSTING_OPTIONS,
  MAINTENANCE,
  PAYMENT,
  PROJECT_SERVICES,
} from '../config/pricing';

const money = (value: number) => value.toLocaleString('en-US');
const usd = (value: number) => `${money(value)} ${CURRENCY}`;
const waLink = (name: string) => whatsappLink(`Hola, me interesa: ${name}`);
const waGeneral = whatsappLink('¡Hola Bit & Byte Studio! Quiero una página para mi negocio.');

const managedHosting = HOSTING_OPTIONS.find((option) => option.id === 'managed');
const gestionHosting = managedHosting?.priceByService?.gestion;
const domainPrice = DOMAIN_OPTION.price;
const hostingPrice = managedHosting?.price ?? null;
const maintenanceAnnual = MAINTENANCE.annualFrom;

const maintenancePrice =
  MAINTENANCE.annualFrom !== undefined
    ? `Desde ${money(MAINTENANCE.from)} ${CURRENCY}${MAINTENANCE.suffix ?? ''}, o ${money(MAINTENANCE.annualFrom)} ${CURRENCY}/mes si pagas el año completo.`
    : `Desde ${money(MAINTENANCE.from)} ${CURRENCY}${MAINTENANCE.suffix ?? ''}.`;

const publishingNote =
  domainPrice !== null && hostingPrice !== null && gestionHosting && maintenanceAnnual !== undefined
    ? `Para que tu página salga en Google con tu propio nombre necesita dominio (${usd(domainPrice)} al año) y alojamiento (desde ${usd(hostingPrice)} al mes; ${usd(gestionHosting.price)} al mes en sistemas de gestión), que se pagan aparte. El mantenimiento anual es opcional (${usd(maintenanceAnnual)} al mes).`
    : 'El dominio, el alojamiento y el mantenimiento se pagan aparte.';
---

<section id="servicios" class="surface-light bg-[#F7F5F2] py-20 md:py-[120px] px-4 md:px-6 text-[#1A1A1A] scroll-mt-24" data-services>
  <div class="max-w-[1280px] mx-auto">
    <div class="mb-14 md:mb-16 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
      <div>
        <p class="font-technical text-sm font-bold text-coral-ink mb-2 uppercase tracking-widest">servicios y precios</p>
        <h2 class="font-sora text-3xl md:text-4xl lg:text-[40px] font-bold text-[#1A1A1A] leading-tight">
          Lo que hacemos y cuánto cuesta
        </h2>
      </div>
      <p class="font-inter text-sm text-[#4A4A4A] max-w-md">
        Precios de partida. El precio final lo cerramos contigo por WhatsApp según lo que necesites. Abre un servicio
        para ver qué incluye.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 md:gap-6 items-stretch isolate">
      {
        PROJECT_SERVICES.map((service) => {
          const detail = SERVICE_DETAILS[service.id];
          const panelId = `servicio-${service.id}`;
          return (
            <li
              data-service-card={service.id}
              class="service-card group bg-white p-6 rounded-2xl border border-[#E5E0D8] relative flex flex-col h-full"
            >
              <div class="flex items-start justify-between gap-3 mb-5">
                <div class="w-11 h-11 rounded-xl bg-[#FD625D]/10 flex items-center justify-center text-coral-ink shrink-0 ring-1 ring-[#FD625D]/15">
                  <span class="material-symbols-outlined text-[1.35rem]" aria-hidden="true">{service.icon}</span>
                </div>
                <span
                  class="font-technical text-[10px] uppercase tracking-wider text-[#8A8A8E] border border-[#E5E0D8] rounded-full px-2.5 py-1 bg-[#F7F5F2]/80 group-[&.is-open]:border-[#FD625D]/35 group-[&.is-open]:text-coral-ink transition-colors"
                >
                  <span class="group-[&.is-open]:hidden">Ver detalle</span>
                  <span class="hidden group-[&.is-open]:inline">Abierto</span>
                </span>
              </div>

              <h3 class="font-sora text-lg md:text-xl font-bold text-[#1A1A1A] mb-2">
                <button
                  type="button"
                  aria-expanded="false"
                  aria-controls={panelId}
                  data-service-toggle
                  class="text-left w-full flex items-start justify-between gap-3 after:absolute after:inset-0 after:content-[''] after:rounded-2xl"
                >
                  <span class="leading-snug pr-1">{service.name}</span>
                  <span
                    class="material-symbols-outlined text-xl text-[#5B5B5E] shrink-0 mt-0.5"
                    data-service-chevron
                    aria-hidden="true"
                  >
                    expand_more
                  </span>
                </button>
              </h3>

              <p class="font-inter text-sm text-[#5B5B5E] leading-relaxed mb-6 flex-1">{service.description}</p>

              <div class="mt-auto pt-4 border-t border-[#E5E0D8]">
                <p class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
                  <span class="font-technical text-[10px] uppercase tracking-wider text-[#8A8A8E]">desde</span>
                  <span class="text-coral-ink text-[1.75rem] md:text-3xl font-bold font-sora leading-none tracking-tight">
                    {money(service.from)}
                  </span>
                  <span class="font-technical text-sm text-[#5B5B5E]">{CURRENCY}</span>
                </p>
                {
                  service.suffix ? (
                    <p class="font-technical text-xs text-[#0b6b4d] mt-1.5">{service.suffix}</p>
                  ) : null
                }
                <p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-[#F7F5F2] px-2.5 py-1 font-inter text-xs text-[#4A4A4A]">
                  <span class="material-symbols-outlined text-sm text-[#8a6a10]" aria-hidden="true">schedule</span>
                  <span>Plazo: {service.leadTime}</span>
                </p>
              </div>

              <div
                id={panelId}
                data-service-panel
                class="service-card__collapse"
                aria-hidden="true"
              >
                <div class="service-card__collapse-inner">
                  <div class="service-card__collapse-body pt-4 pb-6 space-y-5">
                    <div>
                      <h4 class="font-technical text-xs font-bold text-[#0b6b4d] uppercase tracking-wider mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-base" aria-hidden="true">check_circle</span>
                        Qué incluye
                      </h4>
                      <ul class="space-y-2.5">
                        {detail.highlights.map((item) => (
                          <li class="flex items-start gap-2.5 text-sm font-inter text-[#1A1A1A] leading-snug">
                            <span
                              class="mt-0.5 w-1.5 h-1.5 rounded-full bg-coral-ink shrink-0"
                              aria-hidden="true"
                            />
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="rounded-xl bg-[#F7F5F2] px-3.5 py-3">
                      <h4 class="font-technical text-[10px] font-bold text-[#8a6a10] uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm" aria-hidden="true">storefront</span>
                        Ideal para
                      </h4>
                      <p class="text-sm font-inter text-[#1A1A1A] leading-relaxed">{detail.idealFor}</p>
                    </div>
                    <div>
                      <a
                        href={waLink(service.name)}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-track="whatsapp"
                        data-track-source={`servicio:${service.id}`}
                        aria-label={`Pedir por WhatsApp: ${service.name} (se abre en una pestaña nueva)`}
                        class="relative z-10 block bg-coral-strong hover:bg-coral-strong-hover text-white px-6 py-3 rounded-full font-sora text-sm font-semibold transition-colors text-center"
                      >
                        Pedir por WhatsApp
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-10 space-y-6">
      <p class="font-inter text-sm md:text-base text-[#4A4A4A] leading-relaxed">
        {publishingNote}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        <div class="rounded-2xl border border-dashed border-[#D5CFC6] bg-white/50 px-5 py-5 flex flex-col h-full">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-xl text-[#8A8A8E]" aria-hidden="true">{MAINTENANCE.icon}</span>
            <h3 class="font-sora text-base font-semibold text-[#1A1A1A]">{MAINTENANCE.name}</h3>
          </div>
          <p class="font-inter text-sm text-[#5B5B5E] leading-relaxed">
            {MAINTENANCE.description} {maintenancePrice} Se contrata por separado y no es obligatorio.
          </p>
          {
            MAINTENANCE.includes && MAINTENANCE.includes.length > 0 && (
              <p class="mt-2 font-inter text-xs text-[#6A6A6E] leading-relaxed">
                {MAINTENANCE.includes.join(' · ')}
              </p>
            )
          }
          <a
            href={waLink(MAINTENANCE.name)}
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp"
            data-track-source="servicio:mantenimiento"
            aria-label={`Pedir por WhatsApp: ${MAINTENANCE.name} (se abre en una pestaña nueva)`}
            class="mt-auto pt-4 inline-block font-inter text-sm text-[#5B5B5E] underline underline-offset-4 decoration-[#C4BEB6] hover:text-[#1A1A1A] transition-colors"
          >
            Pedir por WhatsApp
          </a>
        </div>

        <div class="rounded-2xl bg-white border border-[#E5E0D8] px-5 py-5 flex flex-col h-full">
          <h3 class="font-technical text-xs font-bold text-[#0b6b4d] uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-base" aria-hidden="true">payments</span>
            Cómo se paga
          </h3>
          <p class="font-inter text-sm text-[#1A1A1A] mb-2">{PAYMENT.terms}</p>
          <p class="font-inter text-sm text-[#5B5B5E] mb-2">Métodos: {PAYMENT.methods.join(', ')}.</p>
          <p class="font-inter text-sm text-[#5B5B5E] mt-auto">{CURRENCY_NOTE}</p>
        </div>
      </div>
    </div>

    <div class="mt-10 flex justify-center">
      <a
        href={waGeneral}
        target="_blank"
        rel="noopener noreferrer"
        data-track="whatsapp"
        data-track-source="servicios"
        aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
        class="bg-coral-strong hover:bg-coral-strong-hover text-white px-8 py-3.5 rounded-full font-sora text-sm font-semibold transition-colors glow-coral text-center"
      >
        Escribir por WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
  import { mountAll } from '../lib/lifecycle';

  function initServices(root: HTMLElement, signal: AbortSignal) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-service-card]'));

    const setOpen = (card: HTMLElement, open: boolean) => {
      const toggle = card.querySelector<HTMLButtonElement>('[data-service-toggle]');
      const panel = card.querySelector<HTMLElement>('[data-service-panel]');
      if (!toggle || !panel) return;

      card.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
    };

    cards.forEach((card) => {
      const toggle = card.querySelector<HTMLButtonElement>('[data-service-toggle]');
      if (!toggle) return;

      toggle.addEventListener(
        'click',
        () => {
          const willOpen = !card.classList.contains('is-open');
          cards.forEach((other) => setOpen(other, other === card ? willOpen : false));

          if (willOpen) {
            window.requestAnimationFrame(() => {
              card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
          }
        },
        { signal },
      );
    });
  }

  mountAll('[data-services]', initServices);
</script>
