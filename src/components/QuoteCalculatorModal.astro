---
import {
  CURRENCY,
  CURRENCY_NOTE,
  DEFAULT_PUBLISHING_ID,
  EXTRAS,
  MAINTENANCE,
  PROJECT_SERVICES,
  PUBLISHING_OPTIONS,
  type PublishingOption,
} from '../config/pricing';
import { calculateQuote, formatLineAmount } from '../lib/quote';

const money = (value: number) => value.toLocaleString('en-US');
const publishingPrice = (option: PublishingOption) =>
  option.price === 0
    ? 'Gratis'
    : formatLineAmount({ amount: option.price, billing: option.billing }).replace(/^a consultar$/, 'precio a consultar');

const initialService = PROJECT_SERVICES[0];
const initialQuote = calculateQuote(initialService.id);
---

<div
  data-quote-modal
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fadeIn hidden"
  hidden
>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="quote-title"
    tabindex="-1"
    class="bg-[#1A1A1A] border border-[#353437] rounded-2xl w-full max-w-3xl max-h-[92vh] overflow-y-auto shadow-2xl text-white outline-none"
  >
    <div class="sticky top-0 bg-[#1A1A1A]/95 backdrop-blur-md border-b border-[#2A2A2A] px-6 py-4 flex items-center justify-between z-10">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-[#58ddb0]" aria-hidden="true"></span>
        <span class="font-technical text-xs text-[#58ddb0] uppercase tracking-wider">
          // COTIZADOR · BIT &amp; BYTE
        </span>
      </div>
      <button
        type="button"
        data-quote-close
        class="w-8 h-8 rounded-full bg-[#2A2A2A] hover:bg-[#353437] flex items-center justify-center text-[#9CA3AF] hover:text-white transition-colors"
        aria-label="Cerrar cotizador"
      >
        <span class="material-symbols-outlined text-xl" aria-hidden="true">close</span>
      </button>
    </div>

    <div class="p-6 md:p-8 space-y-8">
      <div>
        <h2 id="quote-title" class="font-sora text-2xl md:text-3xl font-bold text-white mb-2">
          Calcula tu presupuesto
        </h2>
        <p class="font-inter text-sm text-[#9CA3AF]">
          Elige lo que necesitas y te mostramos un estimado de partida. El precio final lo confirmamos por WhatsApp.
        </p>
      </div>

      <div>
        <span class="font-technical text-xs text-[#fd625d] font-bold uppercase tracking-wider block mb-3" id="quote-service-label">
          1. ¿Qué necesitas?
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="group" aria-labelledby="quote-service-label">
          {
            PROJECT_SERVICES.map((service) => (
              <button
                type="button"
                data-service={service.id}
                aria-pressed={service.id === initialService.id ? 'true' : 'false'}
                class:list={[
                  'quote-service p-4 rounded-xl border text-left transition-all',
                  service.id === initialService.id
                    ? 'is-active bg-[#fd625d]/10 border-[#fd625d] text-white shadow-md'
                    : 'bg-[#131315] border-[#2A2A2A] text-[#9CA3AF] hover:border-[#353437]',
                ]}
              >
                <div class="font-sora font-semibold text-sm mb-1">{service.name}</div>
                <div class="font-technical text-xs text-[#fd625d]">
                  desde {money(service.from)} {CURRENCY}
                  {service.suffix ? ` · ${service.suffix}` : ''}
                </div>
              </button>
            ))
          }
        </div>

        <label
          data-maintenance-label
          class="mt-3 flex items-start justify-between p-3.5 rounded-xl border bg-[#131315] border-[#2A2A2A] text-[#9CA3AF] cursor-pointer transition-all"
        >
          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              data-maintenance
              class="mt-0.5 w-4 h-4 rounded border-[#353437] text-[#fd625d] focus:ring-[#fd625d]"
            />
            <span class="text-sm font-inter">Añadir mantenimiento mensual</span>
          </div>
          <span class="font-technical text-xs font-bold text-[#edc157] ml-2 whitespace-nowrap">
            +{money(MAINTENANCE.from)} {CURRENCY}{MAINTENANCE.suffix}
          </span>
        </label>
      </div>

      <div>
        <span class="font-technical text-xs text-[#fd625d] font-bold uppercase tracking-wider block mb-3" id="quote-extras-label">
          2. Extras (opcional)
        </span>
        <div class="grid grid-cols-1 gap-3" role="group" aria-labelledby="quote-extras-label">
          {
            EXTRAS.map((extra) => (
              <div
                data-extra-row={extra.id}
                class="quote-extra flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-xl border bg-[#131315] border-[#2A2A2A] text-[#9CA3AF] transition-all"
              >
                <label class="flex items-center gap-3 cursor-pointer flex-1 min-w-[12rem]">
                  <input
                    type="checkbox"
                    data-extra={extra.id}
                    class="w-4 h-4 rounded border-[#353437] text-[#fd625d] focus:ring-[#fd625d]"
                  />
                  <span class="text-sm font-inter">{extra.name}</span>
                </label>

                <div class="flex items-center gap-4">
                  {extra.quantity && (
                    <label class="flex items-center gap-2 text-xs font-technical">
                      <span class="sr-only">{extra.quantity.label}</span>
                      <span aria-hidden="true">×</span>
                      <input
                        type="number"
                        inputmode="numeric"
                        data-extra-qty={extra.id}
                        min="1"
                        max={extra.quantity.max}
                        value="1"
                        disabled
                        aria-label={extra.quantity.label}
                        class="w-16 bg-[#1A1A1A] border border-[#353437] rounded-lg px-2 py-1 text-white text-center disabled:opacity-40"
                      />
                    </label>
                  )}
                  <span class="font-technical text-xs font-bold text-[#edc157] whitespace-nowrap">
                    {`+${money(extra.price ?? 0)} ${CURRENCY}${extra.unit ? ` ${extra.unit}` : ''}`}
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <fieldset>
        <legend class="font-technical text-xs text-[#fd625d] font-bold uppercase tracking-wider block mb-3">
          3. Publicación
        </legend>
        <div class="grid grid-cols-1 gap-3">
          {
            PUBLISHING_OPTIONS.map((option) => (
              <label
                data-publishing-row={option.id}
                class="flex items-start justify-between gap-3 p-3.5 rounded-xl border bg-[#131315] border-[#2A2A2A] text-[#9CA3AF] cursor-pointer transition-all"
              >
                <div class="flex items-start gap-3">
                  <input
                    type="radio"
                    name="quote-publishing"
                    value={option.id}
                    data-publishing={option.id}
                    checked={option.id === DEFAULT_PUBLISHING_ID}
                    class="mt-0.5 w-4 h-4 border-[#353437] text-[#fd625d] focus:ring-[#fd625d]"
                  />
                  <span>
                    <span class="block text-sm font-inter">{option.name}</span>
                    <span class="block text-xs font-inter opacity-80 mt-0.5">{option.description}</span>
                  </span>
                </div>
                <span class="font-technical text-xs font-bold text-[#edc157] whitespace-nowrap">
                  {publishingPrice(option)}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="bg-[#131315] p-6 rounded-2xl border-2 border-[#fd625d]/60 shadow-xl space-y-5">
        <div aria-live="polite">
          <div class="font-technical text-xs text-[#9CA3AF] uppercase mb-1">Pago único del proyecto</div>
          <div class="font-sora text-3xl md:text-4xl font-bold text-white flex items-baseline gap-2">
            <span class="text-sm font-normal text-[#9CA3AF] font-inter">desde</span>
            <span data-quote-total>{money(initialQuote.oneTime)}</span>
            <span class="text-sm font-normal text-[#9CA3AF] font-inter">{CURRENCY}</span>
          </div>
          <p class="text-xs font-technical text-[#58ddb0] mt-2">
            Plazo orientativo: <span data-quote-leadtime>{initialQuote.leadTime}</span>
          </p>
          <ul data-quote-once class="mt-3 space-y-1.5 text-sm font-inter text-[#e5e1e4]"></ul>
        </div>

        <div class="border-t border-[#2A2A2A] pt-4" aria-live="polite">
          <div class="font-technical text-xs text-[#9CA3AF] uppercase mb-2">Pago recurrente</div>
          <ul data-quote-recurring class="space-y-1.5 text-sm font-inter text-[#e5e1e4]"></ul>
          <p data-quote-empty class="text-sm font-inter text-[#9CA3AF] hidden" hidden>Ninguno.</p>
        </div>

        <p class="text-xs font-inter text-[#9CA3AF]">
          Precio final por WhatsApp. {CURRENCY_NOTE}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 sm:justify-end">
          <button
            type="button"
            data-quote-close
            class="px-5 py-3 rounded-full border border-[#353437] text-white font-sora text-sm hover:bg-[#2A2A2A] transition-colors text-center"
          >
            Cerrar
          </button>
          <button
            type="button"
            data-quote-whatsapp
            aria-label="Enviar la cotización por WhatsApp (se abre en una pestaña nueva)"
            class="px-6 py-3 rounded-full bg-[#fd625d] text-white font-sora text-sm font-semibold hover:scale-105 transition-all glow-coral flex items-center justify-center gap-2"
          >
            <span class="material-symbols-outlined text-lg" aria-hidden="true">send</span>
            <span>Enviar por WhatsApp</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { OPEN_QUOTE_EVENT, openQuote, type OpenQuoteDetail } from '../lib/events';
  import { whatsappLink } from '../config/contact';
  import {
    DEFAULT_PUBLISHING_ID,
    PROJECT_SERVICES,
    PUBLISHING_OPTIONS,
    type ExtraId,
    type ProjectServiceId,
    type PublishingId,
  } from '../config/pricing';
  import {
    calculateQuote,
    formatLineAmount,
    oneTimeLines,
    quoteToMessage,
    recurringLines,
    type QuoteExtraInput,
    type QuoteLine,
  } from '../lib/quote';
  import { mountAll } from '../lib/lifecycle';
  import { createModal } from '../lib/modal';

  const SERVICE_ACTIVE = ['is-active', 'bg-[#fd625d]/10', 'border-[#fd625d]', 'text-white', 'shadow-md'];
  const SERVICE_INACTIVE = ['bg-[#131315]', 'border-[#2A2A2A]', 'text-[#9CA3AF]'];
  const ROW_ACTIVE = ['border-[#fd625d]', 'text-white'];
  const ROW_INACTIVE = ['border-[#2A2A2A]', 'text-[#9CA3AF]'];

  const isServiceId = (value: string | undefined): value is ProjectServiceId =>
    PROJECT_SERVICES.some((service) => service.id === value);

  const isPublishingId = (value: string | undefined): value is PublishingId =>
    PUBLISHING_OPTIONS.some((option) => option.id === value);

  function lineItem(line: QuoteLine): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'flex justify-between gap-4';
    const label = document.createElement('span');
    label.textContent = line.label;
    const amount = document.createElement('span');
    amount.className = 'font-technical text-xs text-[#edc157] whitespace-nowrap';
    amount.textContent = formatLineAmount(line);
    li.append(label, amount);
    return li;
  }

  function initQuoteModal(root: HTMLElement, signal: AbortSignal) {
    const serviceButtons = Array.from(root.querySelectorAll<HTMLElement>('[data-service]'));
    const extraInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-extra]'));
    const maintenanceInput = root.querySelector<HTMLInputElement>('[data-maintenance]');
    const totalEl = root.querySelector<HTMLElement>('[data-quote-total]');
    const leadTimeEl = root.querySelector<HTMLElement>('[data-quote-leadtime]');
    const onceEl = root.querySelector<HTMLElement>('[data-quote-once]');
    const recurringEl = root.querySelector<HTMLElement>('[data-quote-recurring]');
    const emptyEl = root.querySelector<HTMLElement>('[data-quote-empty]');
    const publishingInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-publishing]'));

    if (!serviceButtons.length || !maintenanceInput) return;

    const modal = createModal(root, signal);
    let serviceId: ProjectServiceId = PROJECT_SERVICES[0].id;

    const qtyInput = (id: string) => root.querySelector<HTMLInputElement>(`[data-extra-qty="${id}"]`);

    const selectedExtras = (): QuoteExtraInput[] =>
      extraInputs
        .filter((input) => input.checked)
        .map((input) => {
          const id = input.dataset.extra as ExtraId;
          const qty = qtyInput(id);
          return { id, quantity: qty ? Number(qty.value) : undefined };
        });

    const selectedPublishing = (): PublishingId => {
      const value = publishingInputs.find((input) => input.checked)?.value;
      return isPublishingId(value) ? value : DEFAULT_PUBLISHING_ID;
    };

    const currentQuote = () =>
      calculateQuote(serviceId, selectedExtras(), {
        maintenance: maintenanceInput.checked,
        publishing: selectedPublishing(),
      });

    const paintRow = (el: HTMLElement | null, active: boolean) => {
      if (!el) return;
      el.classList.remove(...(active ? ROW_INACTIVE : ROW_ACTIVE));
      el.classList.add(...(active ? ROW_ACTIVE : ROW_INACTIVE));
    };

    const render = () => {
      extraInputs.forEach((input) => {
        const id = input.dataset.extra ?? '';
        const qty = qtyInput(id);
        if (qty) qty.disabled = !input.checked;
        paintRow(input.closest<HTMLElement>('[data-extra-row]'), input.checked);
      });
      paintRow(root.querySelector<HTMLElement>('[data-maintenance-label]'), maintenanceInput.checked);
      publishingInputs.forEach((input) => {
        paintRow(input.closest<HTMLElement>('[data-publishing-row]'), input.checked);
      });

      const quote = currentQuote();
      if (totalEl) totalEl.textContent = quote.oneTime.toLocaleString('en-US');
      if (leadTimeEl) leadTimeEl.textContent = quote.leadTime;
      onceEl?.replaceChildren(...oneTimeLines(quote).map(lineItem));

      const recurring = recurringLines(quote);
      recurringEl?.replaceChildren(...recurring.map(lineItem));
      if (emptyEl) {
        emptyEl.classList.toggle('hidden', recurring.length > 0);
        emptyEl.hidden = recurring.length > 0;
      }
    };

    const setService = (id: ProjectServiceId) => {
      serviceId = id;
      serviceButtons.forEach((button) => {
        const active = button.dataset.service === id;
        button.classList.remove(...(active ? SERVICE_INACTIVE : SERVICE_ACTIVE));
        button.classList.add(...(active ? SERVICE_ACTIVE : SERVICE_INACTIVE));
        button.setAttribute('aria-pressed', String(active));
      });
      render();
    };

    const open = (service?: string) => {
      setService(isServiceId(service) ? service : serviceId);
      modal.open();
    };

    serviceButtons.forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          const id = button.dataset.service;
          if (isServiceId(id)) setService(id);
        },
        { signal },
      );
    });

    [...extraInputs, ...publishingInputs, maintenanceInput].forEach((input) => {
      input.addEventListener('change', render, { signal });
    });
    root.querySelectorAll<HTMLInputElement>('[data-extra-qty]').forEach((input) => {
      input.addEventListener('input', render, { signal });
    });

    root.querySelectorAll<HTMLElement>('[data-quote-close]').forEach((button) => {
      button.addEventListener('click', modal.close, { signal });
    });

    root.querySelector<HTMLElement>('[data-quote-whatsapp]')?.addEventListener(
      'click',
      () => window.open(whatsappLink(quoteToMessage(currentQuote())), '_blank', 'noopener,noreferrer'),
      { signal },
    );

    // Single delegated trigger for every [data-open-quote] element on the page.
    document.addEventListener(
      'click',
      (event) => {
        const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-open-quote]');
        if (trigger) openQuote(trigger.getAttribute('data-open-quote') || undefined);
      },
      { signal },
    );

    window.addEventListener(
      OPEN_QUOTE_EVENT,
      (event) => open((event as CustomEvent<OpenQuoteDetail>).detail?.service),
      { signal },
    );

    setService(serviceId);
  }

  mountAll('[data-quote-modal]', initQuoteModal);
</script>
