---
import '../styles/global.css';
import { Font } from 'astro:assets';
import {
  EMAIL,
  FACEBOOK_URL,
  GITHUB_URL,
  TELEGRAM_URL,
  WHATSAPP_NUMBER,
} from '../config/contact';
import { SITE_DESCRIPTION, SITE_NAME, SITE_TITLE, UMAMI_SCRIPT_URL, UMAMI_WEBSITE_ID } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Keeps the page out of search results; also drops canonical and og:url. */
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = '/og.png',
  imageAlt = 'Bit & Byte Studio: webs y software a medida para negocios en Cuba',
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const logo = new URL('/logo-bit-byte.png', site).href;

// summary_large_image needs a wide image; fall back to the compact card for anything else.
const twitterCard = imageWidth === 1200 && imageHeight === 630 ? 'summary_large_image' : 'summary';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.origin}/#organization`,
  name: SITE_NAME,
  url: site.href,
  logo,
  image: ogImage,
  description,
  areaServed: 'Cuba',
  email: EMAIL,
  telephone: `+${WHATSAPP_NUMBER}`,
  sameAs: [FACEBOOK_URL, TELEGRAM_URL, GITHUB_URL],
};

// "<" is escaped so the JSON can never close the script tag.
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#131315" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_CU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={jsonLdString} />

    {
      import.meta.env.PROD && (
        <script is:inline defer src={UMAMI_SCRIPT_URL} data-website-id={UMAMI_WEBSITE_ID} />
      )
    }

    <Font cssVariable="--font-sora" preload={[{ weight: 700, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-inter" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-jetbrains" />
    <Font cssVariable="--font-material-symbols" preload />
    <slot name="head" />
  </head>
  <body class="bg-[#131315] text-[#e5e1e4] antialiased selection:bg-[#fd625d] selection:text-white">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-white focus:text-[#131315] focus:px-4 focus:py-2 focus:rounded-full focus:font-sora focus:text-sm focus:font-semibold"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
