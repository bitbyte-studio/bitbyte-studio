---
import { Picture } from 'astro:assets';
import { SERVICES } from '../config/pricing';
import { PROJECTS } from '../data';

const serviceNameById = Object.fromEntries(SERVICES.map((service) => [service.id, service.name]));
---

<div
  data-project-modal
  class="modal-shell fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm hidden"
  hidden
>
  <div
    role="dialog"
    aria-modal="true"
    tabindex="-1"
    class="scrollbar-dark bg-[#1A1A1A] border border-[#353437] rounded-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto shadow-2xl text-white relative outline-none will-change-transform"
  >
    {
      PROJECTS.map((project) => (
        <div data-project-panel={project.id} class="project-panel hidden" hidden>
          <div class="sticky top-0 bg-[#1A1A1A]/95 backdrop-blur-md border-b border-[#2A2A2A] px-5 md:px-6 py-4 flex items-center justify-between gap-4 z-10">
            <div class="min-w-0">
              <p class="font-technical text-xs text-[#9CA3AF] uppercase tracking-wider truncate">
                Demo · {project.category}
              </p>
            </div>
            <button
              type="button"
              data-project-close
              class="w-9 h-9 shrink-0 rounded-full border border-[#353437] bg-transparent hover:bg-[#2A2A2A] flex items-center justify-center text-[#9CA3AF] hover:text-white transition-colors"
              aria-label="Cerrar modal"
            >
              <span class="material-symbols-outlined text-xl" aria-hidden="true">close</span>
            </button>
          </div>

          <div class="p-5 md:p-8 space-y-7">
            <div class="rounded-2xl overflow-hidden border border-[#2A2A2A] bg-[#131315]">
              <Picture
                src={project.image.modal}
                alt={`Vista previa de la demo ${project.title}`}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[640, 960, 1440, 1800]}
                sizes="(min-width: 928px) 832px, (min-width: 768px) calc(100vw - 6rem), calc(100vw - 5rem)"
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </div>

            <div>
              <p class="font-technical text-xs text-[#9CA3AF] uppercase tracking-wider mb-3">
                {project.badge} · {project.category}
              </p>
              <h2
                id={`project-title-${project.id}`}
                class="font-sora text-2xl md:text-3xl font-bold text-white mb-3 leading-tight"
              >
                {project.title}
              </h2>
              <p class="font-inter text-sm md:text-base text-[#B0B0B5] leading-relaxed max-w-3xl">
                {project.description}
              </p>
            </div>

            <div>
              <h3 class="font-sora text-sm font-semibold text-white mb-3">Qué incluye</h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                {project.features.map((feature) => (
                  <li class="flex items-start gap-3 rounded-xl border border-[#2A2A2A] bg-[#131315] px-3.5 py-3 font-inter text-sm text-[#E5E1E4]">
                    <span class="material-symbols-outlined text-[#fd625d] shrink-0 text-xl" aria-hidden="true">
                      check_circle
                    </span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-6 border-t border-[#2A2A2A] flex flex-col gap-4">
              <p class="font-inter text-sm text-[#9CA3AF]">
                ¿Te gustaría algo parecido a <strong class="text-white">{project.title}</strong> para tu negocio?
              </p>
              <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <a
                  href={project.liveUrl}
                  data-track-demo={project.id}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Probar demo de ${project.title} (se abre en una pestaña nueva)`}
                  class="inline-flex w-full sm:w-auto items-center justify-center gap-2 px-6 py-3 rounded-full bg-coral-strong hover:bg-coral-strong-hover text-white transition-colors font-sora text-sm font-semibold glow-coral"
                >
                  <span>Probar demo</span>
                  <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
                </a>
                <a
                  href="#contacto"
                  data-project-contact
                  data-project-id={project.id}
                  data-project-title={project.title}
                  data-project-category={project.category}
                  data-project-features={project.features.slice(0, 3).join('|')}
                  data-contact-service={serviceNameById[project.serviceId] ?? ''}
                  class="inline-flex w-full sm:w-auto items-center justify-center px-6 py-3 rounded-full border border-[#353437] text-white font-sora text-sm font-semibold hover:bg-[#2A2A2A] transition-colors"
                >
                  Quiero algo parecido
                </a>
                <button
                  type="button"
                  data-project-close
                  class="w-full sm:w-auto px-4 py-3 font-inter text-sm text-[#9CA3AF] underline underline-offset-4 hover:text-white transition-colors"
                >
                  Cerrar
                </button>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { track } from '../lib/analytics';
  import {
    OPEN_PROJECT_EVENT,
    prefillContact,
    type OpenProjectDetail,
  } from '../lib/events';
  import { mountAll } from '../lib/lifecycle';
  import { createModal, setVisible } from '../lib/modal';

  function initProjectModal(modal: HTMLElement, signal: AbortSignal) {
    const panels = Array.from(modal.querySelectorAll<HTMLElement>('[data-project-panel]'));
    const { open: openModal, close } = createModal(modal, signal);

    const dialog = modal.querySelector<HTMLElement>('[role="dialog"]')!;

    const open = (projectId: string) => {
      panels.forEach((panel) => setVisible(panel, panel.dataset.projectPanel === projectId));
      dialog.setAttribute('aria-labelledby', `project-title-${projectId}`);
      openModal();
      // scrollTop only applies once the modal is visible (display: none has no layout).
      dialog.scrollTop = 0;
    };

    modal.querySelectorAll<HTMLElement>('[data-project-close]').forEach((button) => {
      button.addEventListener('click', close, { signal });
    });

    modal.querySelectorAll<HTMLElement>('[data-track-demo]').forEach((link) => {
      link.addEventListener('click', () => track('project_demo_click', { project: link.dataset.trackDemo }), { signal });
    });

    const buildContactTemplate = (link: HTMLAnchorElement) => {
      const title = link.dataset.projectTitle?.trim();
      if (!title) return '';
      const category = link.dataset.projectCategory?.trim() || 'negocio';
      const highlights = (link.dataset.projectFeatures ?? '')
        .split('|')
        .map((feature) => feature.trim())
        .filter(Boolean)
        .map((feature) => `• ${feature}`)
        .join('\n');

      return [
        `Quiero algo parecido a «${title}» (${category}).`,
        '',
        'Ideas que me gustaron de la demo:',
        highlights,
        '',
        'Mi negocio es: ',
        'Lo que quiero lograr: ',
      ]
        .filter((line, index, lines) => line !== '' || (index > 0 && lines[index - 1] !== ''))
        .join('\n');
    };

    modal.querySelectorAll<HTMLAnchorElement>('[data-project-contact]').forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          const project = link.dataset.projectId;
          const service = link.dataset.contactService ?? '';
          const message = buildContactTemplate(link);
          close();
          if (message) {
            prefillContact({ service, message, project });
            track('contact_prefill', { source: 'project_modal', project, service: service || undefined });
          }
        },
        { signal },
      );
    });

    window.addEventListener(
      OPEN_PROJECT_EVENT,
      (event) => {
        const project = (event as CustomEvent<OpenProjectDetail>).detail?.project;
        if (project?.id) open(project.id);
      },
      { signal },
    );
  }

  mountAll('[data-project-modal]', initProjectModal);
</script>
