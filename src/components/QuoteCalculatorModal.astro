---
const projectTypes = [
  { id: 'landing', label: 'Landing Page', base: '$499' },
  { id: 'webapp', label: 'Web App / SaaS', base: '$999' },
  { id: 'ecommerce', label: 'E-commerce', base: '$1,499' },
  { id: 'hardware', label: 'Hardware / IoT', base: '$1,800' },
] as const;

const addons = [
  { id: 'cms', label: 'CMS Auto-gestionable (Sanity / Headless)', price: '+$200', checked: true },
  { id: 'seo', label: 'SEO Técnico Avanzado & Schema OpenGraph', price: '+$150', checked: false },
  { id: 'animations', label: 'Animaciones 3D (Three.js / GSAP en capas)', price: '+$300', checked: false },
  { id: 'automation', label: 'Integración APIs y Flujos Automatizados', price: '+$250', checked: false },
  { id: 'priority', label: 'Entrega Prioritaria (Sprint Ágil en 14 días)', price: '+$400', checked: false },
] as const;

// Defaults must match the calculator: landing + 3 pages + CMS
const initialPages = 3;
const initialTotal = 499 + (initialPages - 1) * 80 + 200; // 859
const initialWeeks = 3;
---

<div
  data-quote-modal
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fadeIn hidden"
  hidden
>
  <div class="bg-[#1A1A1A] border border-[#353437] rounded-2xl w-full max-w-3xl max-h-[92vh] overflow-y-auto shadow-2xl text-white">
    <div class="sticky top-0 bg-[#1A1A1A]/95 backdrop-blur-md border-b border-[#2A2A2A] px-6 py-4 flex items-center justify-between z-10">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-[#58ddb0]"></span>
        <span class="font-technical text-xs text-[#58ddb0] uppercase tracking-wider">
          // COTIZADOR INTERACTIVO DE INGENIERÍA · BIT &amp; BYTE
        </span>
      </div>
      <button
        type="button"
        data-quote-close
        class="w-8 h-8 rounded-full bg-[#2A2A2A] hover:bg-[#353437] flex items-center justify-center text-[#9CA3AF] hover:text-white transition-colors"
        aria-label="Cerrar cotizador"
      >
        <span class="material-symbols-outlined text-xl">close</span>
      </button>
    </div>

    <div class="p-6 md:p-8 space-y-8">
      <div>
        <h2 class="font-sora text-2xl md:text-3xl font-bold text-white mb-2">
          Calcula tu Presupuesto al Instante
        </h2>
        <p class="font-inter text-sm text-[#9CA3AF]">
          Selecciona los módulos de tu aplicación para obtener una estimación precisa de tiempo y costos.
        </p>
      </div>

      <div>
        <label class="font-technical text-xs text-[#fd625d] font-bold uppercase tracking-wider block mb-3">
          1. Tipo de Solución Principal
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {
            projectTypes.map((item) => (
              <button
                type="button"
                data-project-type={item.id}
                class:list={[
                  'quote-type p-4 rounded-xl border text-left transition-all',
                  item.id === 'landing'
                    ? 'is-active bg-[#fd625d]/10 border-[#fd625d] text-white shadow-md'
                    : 'bg-[#131315] border-[#2A2A2A] text-[#9CA3AF] hover:border-[#353437]',
                ]}
              >
                <div class="font-sora font-semibold text-sm mb-1">{item.label}</div>
                <div class="font-technical text-xs text-[#fd625d]">{item.base} base</div>
              </button>
            ))
          }
        </div>
      </div>

      <div class="bg-[#131315] p-5 rounded-xl border border-[#2A2A2A]">
        <div class="flex justify-between items-center mb-3">
          <label class="font-sora text-sm font-semibold text-white" for="quote-pages">
            Número estimado de páginas / vistas:
          </label>
          <span data-pages-label class="font-technical text-base font-bold text-[#edc157] px-3 py-1 rounded bg-[#2A2A2A]">
            {initialPages} páginas
          </span>
        </div>
        <input
          id="quote-pages"
          data-pages-range
          type="range"
          min="1"
          max="20"
          value={initialPages}
          class="w-full accent-[#fd625d] cursor-pointer"
        />
        <div class="flex justify-between text-[10px] font-technical text-[#9CA3AF] mt-1">
          <span>1 página (Single screen)</span>
          <span>10 páginas</span>
          <span>20+ páginas</span>
        </div>
      </div>

      <div>
        <label class="font-technical text-xs text-[#fd625d] font-bold uppercase tracking-wider block mb-3">
          2. Características de Ingeniería &amp; Optimización
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {
            addons.map((addon) => (
              <label
                data-addon-label={addon.id}
                class:list={[
                  'quote-addon flex items-start justify-between p-3.5 rounded-xl border cursor-pointer transition-all',
                  addon.checked
                    ? 'is-active bg-[#131315] border-[#fd625d] text-white'
                    : 'bg-[#131315] border-[#2A2A2A] text-[#9CA3AF]',
                ]}
              >
                <div class="flex items-start gap-3">
                  <input
                    type="checkbox"
                    data-addon={addon.id}
                    checked={addon.checked}
                    class="mt-0.5 w-4 h-4 rounded border-[#353437] text-[#fd625d] focus:ring-[#fd625d]"
                  />
                  <span class="text-sm font-inter">{addon.label}</span>
                </div>
                <span class="font-technical text-xs font-bold text-[#edc157] ml-2">{addon.price}</span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="bg-[#131315] p-6 rounded-2xl border-2 border-[#fd625d]/60 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
        <div>
          <div class="font-technical text-xs text-[#9CA3AF] uppercase mb-1">
            INVERSIÓN ESTIMADA DE INGENIERÍA
          </div>
          <div class="font-sora text-3xl md:text-4xl font-bold text-white flex items-baseline gap-2">
            $<span data-quote-total>{initialTotal.toLocaleString('en-US')}</span>
            <span class="text-sm font-normal text-[#9CA3AF] font-inter">USD</span>
          </div>
          <div class="text-xs font-technical text-[#58ddb0] mt-1">
            ⏱ Tiempo estimado de entrega: ~<span data-quote-weeks>{initialWeeks}</span> semanas
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <button
            type="button"
            data-quote-close
            class="px-5 py-3 rounded-full border border-[#353437] text-white font-sora text-sm hover:bg-[#2A2A2A] transition-colors text-center"
          >
            Cerrar
          </button>
          <button
            type="button"
            data-quote-whatsapp
            class="px-6 py-3 rounded-full bg-[#fd625d] text-white font-sora text-sm font-semibold hover:scale-105 transition-all glow-coral flex items-center justify-center gap-2"
          >
            <span class="material-symbols-outlined text-lg">send</span>
            <span>Enviar cotización por WhatsApp</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { OPEN_QUOTE_EVENT, type OpenQuoteDetail } from '../lib/events';

  type ProjectType = 'landing' | 'webapp' | 'ecommerce' | 'hardware';

  function setVisible(el: HTMLElement | null, visible: boolean) {
    if (!el) return;
    el.classList.toggle('hidden', !visible);
    el.hidden = !visible;
  }

  function serviceToType(service?: string): ProjectType {
    if (service === 'E-commerce') return 'ecommerce';
    if (service === 'Hardware') return 'hardware';
    if (service === 'Automation') return 'webapp';
    return 'landing';
  }

  function initQuoteModal(modal: HTMLElement) {
    const pagesRange = modal.querySelector<HTMLInputElement>('[data-pages-range]');
    const pagesLabel = modal.querySelector<HTMLElement>('[data-pages-label]');
    const totalEl = modal.querySelector<HTMLElement>('[data-quote-total]');
    const weeksEl = modal.querySelector<HTMLElement>('[data-quote-weeks]');
    const typeButtons = Array.from(modal.querySelectorAll<HTMLElement>('[data-project-type]'));
    const addonInputs = Array.from(modal.querySelectorAll<HTMLInputElement>('[data-addon]'));

    let projectType: ProjectType = 'landing';

    const close = () => {
      setVisible(modal, false);
      document.body.style.overflow = '';
    };

    const setProjectType = (type: ProjectType) => {
      projectType = type;
      typeButtons.forEach((button) => {
        const active = button.dataset.projectType === type;
        button.classList.toggle('is-active', active);
        button.classList.toggle('bg-[#fd625d]/10', active);
        button.classList.toggle('border-[#fd625d]', active);
        button.classList.toggle('text-white', active);
        button.classList.toggle('shadow-md', active);
        button.classList.toggle('bg-[#131315]', !active);
        button.classList.toggle('border-[#2A2A2A]', !active);
        button.classList.toggle('text-[#9CA3AF]', !active);
      });
      updateEstimate();
    };

    const getAddon = (id: string) =>
      addonInputs.find((input) => input.dataset.addon === id)?.checked ?? false;

    const syncAddonStyles = () => {
      addonInputs.forEach((input) => {
        const label = input.closest<HTMLElement>('[data-addon-label]');
        if (!label) return;
        label.classList.toggle('is-active', input.checked);
        label.classList.toggle('border-[#fd625d]', input.checked);
        label.classList.toggle('text-white', input.checked);
        label.classList.toggle('text-[#9CA3AF]', !input.checked);
      });
    };

    const updateEstimate = () => {
      const pagesCount = Number(pagesRange?.value || 3);
      const basePrice =
        projectType === 'landing'
          ? 499
          : projectType === 'webapp'
            ? 999
            : projectType === 'ecommerce'
              ? 1499
              : 1800;

      const total =
        basePrice +
        (pagesCount - 1) * 80 +
        (getAddon('cms') ? 200 : 0) +
        (getAddon('seo') ? 150 : 0) +
        (getAddon('animations') ? 300 : 0) +
        (getAddon('automation') ? 250 : 0) +
        (getAddon('priority') ? 400 : 0);

      const weeks = getAddon('priority')
        ? 2
        : projectType === 'landing'
          ? 3
          : projectType === 'webapp'
            ? 5
            : projectType === 'ecommerce'
              ? 6
              : 8;

      if (pagesLabel) {
        pagesLabel.textContent = `${pagesCount} ${pagesCount === 1 ? 'página' : 'páginas'}`;
      }
      if (totalEl) totalEl.textContent = total.toLocaleString();
      if (weeksEl) weeksEl.textContent = String(weeks);
    };

    const open = (service?: string) => {
      setProjectType(serviceToType(service));
      setVisible(modal, true);
      document.body.style.overflow = 'hidden';
      updateEstimate();
    };

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setProjectType((button.dataset.projectType || 'landing') as ProjectType);
      });
    });

    pagesRange?.addEventListener('input', updateEstimate);

    addonInputs.forEach((input) => {
      input.addEventListener('change', () => {
        syncAddonStyles();
        updateEstimate();
      });
    });

    modal.querySelectorAll<HTMLElement>('[data-quote-close]').forEach((button) => {
      button.addEventListener('click', close);
    });

    modal.querySelector<HTMLElement>('[data-quote-whatsapp]')?.addEventListener('click', () => {
      const pagesCount = Number(pagesRange?.value || 3);
      const total = Number((totalEl?.textContent || '0').replace(/,/g, ''));
      const weeks = Number(weeksEl?.textContent || '0');
      const text = `¡Hola Bit & Byte Studio! Quisiera cotizar un proyecto:
- Tipo: ${projectType.toUpperCase()}
- Páginas: ${pagesCount}
- CMS incluido: ${getAddon('cms') ? 'Sí' : 'No'}
- SEO Técnico: ${getAddon('seo') ? 'Sí' : 'No'}
- Animaciones 3D/GSAP: ${getAddon('animations') ? 'Sí' : 'No'}
- Automatización APIs: ${getAddon('automation') ? 'Sí' : 'No'}
- Entrega Prioritaria: ${getAddon('priority') ? 'Sí' : 'No'}
>>> Estimación en cotizador: ~$${total} USD (Aprox ${weeks} semanas)`;

      window.open(`https://wa.me/5350000000?text=${encodeURIComponent(text)}`, '_blank');
    });

    modal.addEventListener('click', (event) => {
      if (event.target === modal) close();
    });

    window.addEventListener(OPEN_QUOTE_EVENT, (event) => {
      const detail = (event as CustomEvent<OpenQuoteDetail>).detail;
      open(detail?.service);
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) close();
    });

    syncAddonStyles();
    updateEstimate();
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-quote-modal]').forEach(initQuoteModal);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
