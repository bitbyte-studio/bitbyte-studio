---
import { Picture } from 'astro:assets';
import { PROJECTS } from '../data';
---

<div
  data-project-modal
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fadeIn hidden"
  hidden
>
  <div
    role="dialog"
    aria-modal="true"
    tabindex="-1"
    class="bg-[#1A1A1A] border border-[#353437] rounded-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto shadow-2xl text-white relative outline-none"
  >
    {
      PROJECTS.map((project) => (
        <div data-project-panel={project.id} class="project-panel hidden" hidden>
          <div class="sticky top-0 bg-[#1A1A1A]/95 backdrop-blur-md border-b border-[#2A2A2A] px-6 py-4 flex items-center justify-between z-10">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-[#fd625d]"></span>
              <span class="font-technical text-xs text-[#9CA3AF] uppercase">
                // PROYECTO DEMO · BIT &amp; BYTE STUDIO
              </span>
            </div>
            <button
              type="button"
              data-project-close
              class="w-9 h-9 rounded-full bg-[#2A2A2A] hover:bg-[#353437] flex items-center justify-center text-[#9CA3AF] hover:text-white transition-colors"
              aria-label="Cerrar modal"
            >
              <span class="material-symbols-outlined text-xl" aria-hidden="true">close</span>
            </button>
          </div>

          <div class="p-6 md:p-8 space-y-6">
            <div class="rounded-xl overflow-hidden border border-[#2A2A2A] bg-[#131315]">
              <Picture
                src={project.image.modal}
                alt={`Vista previa de la demo ${project.title}`}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[640, 960, 1440, 1800]}
                sizes="(min-width: 928px) 832px, (min-width: 768px) calc(100vw - 6rem), calc(100vw - 5rem)"
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </div>

            <div>
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <h2 id={`project-title-${project.id}`} class="font-sora text-2xl md:text-3xl font-bold text-white">{project.title}</h2>
                <span class="px-2.5 py-0.5 rounded-full bg-[#58ddb0]/10 border border-[#58ddb0]/40 text-[#58ddb0] font-technical text-xs font-bold uppercase tracking-wider">
                  {project.badge}
                </span>
                <span class="font-technical text-xs text-[#9CA3AF] uppercase tracking-wider">{project.category}</span>
              </div>
              <p class="font-inter text-sm md:text-base text-[#9CA3AF] leading-relaxed">{project.description}</p>
            </div>

            <div>
              <h3 class="font-technical text-xs font-bold text-[#58ddb0] uppercase tracking-wider mb-3">
                // FUNCIONALIDADES
              </h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {project.features.map((feature) => (
                  <li class="flex items-start gap-3 font-inter text-sm text-white">
                    <span class="material-symbols-outlined text-[#fd625d] shrink-0 text-xl" aria-hidden="true">
                      check_circle
                    </span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <ul class="flex flex-wrap gap-2" aria-label="Tecnologías">
              {project.tags.map((tag) => (
                <li class="px-2.5 py-0.5 rounded bg-[#2A2A2A] text-xs font-technical text-[#fd625d]">{tag}</li>
              ))}
            </ul>

            <div>
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ver demo de ${project.title} (se abre en una pestaña nueva)`}
                class="inline-flex w-full sm:w-auto items-center justify-center gap-2 px-6 py-3 rounded-full bg-white text-[#131315] hover:bg-[#ffb3ad] transition-colors font-sora text-sm font-bold"
              >
                <span>Ver demo</span>
                <svg
                  viewBox="0 0 24 24"
                  class="w-4 h-4 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M15 3h6v6" />
                  <path d="M10 14 21 3" />
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                </svg>
              </a>
            </div>

            <div class="pt-6 border-t border-[#2A2A2A] flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="text-sm font-inter text-[#9CA3AF]">
                ¿Te gustaría algo similar a <strong class="text-white">{project.title}</strong>?
              </div>
              <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
                <button
                  type="button"
                  data-project-close
                  class="w-full sm:w-auto px-5 py-2.5 rounded-full border border-[#353437] text-white font-sora text-sm hover:bg-[#2A2A2A] transition-colors"
                >
                  Cerrar
                </button>
                <button
                  type="button"
                  data-quote-similar={project.serviceId}
                  class="w-full sm:w-auto px-6 py-2.5 rounded-full bg-[#fd625d] text-white font-sora text-sm font-semibold whitespace-nowrap hover:scale-105 transition-transform glow-coral"
                >
                  Cotizar Proyecto Similar
                </button>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { OPEN_PROJECT_EVENT, openQuote, type OpenProjectDetail } from '../lib/events';
  import { mountAll } from '../lib/lifecycle';
  import { createModal, setVisible } from '../lib/modal';

  function initProjectModal(modal: HTMLElement, signal: AbortSignal) {
    const panels = Array.from(modal.querySelectorAll<HTMLElement>('[data-project-panel]'));
    const { open: openModal, close } = createModal(modal, signal);

    const dialog = modal.querySelector<HTMLElement>('[role="dialog"]')!;

    const open = (projectId: string) => {
      panels.forEach((panel) => setVisible(panel, panel.dataset.projectPanel === projectId));
      dialog.setAttribute('aria-labelledby', `project-title-${projectId}`);
      openModal();
      // scrollTop only applies once the modal is visible (display: none has no layout).
      dialog.scrollTop = 0;
    };

    modal.querySelectorAll<HTMLElement>('[data-project-close]').forEach((button) => {
      button.addEventListener('click', close, { signal });
    });

    modal.querySelectorAll<HTMLElement>('[data-quote-similar]').forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          close();
          openQuote(button.dataset.quoteSimilar || undefined);
        },
        { signal },
      );
    });

    window.addEventListener(
      OPEN_PROJECT_EVENT,
      (event) => {
        const project = (event as CustomEvent<OpenProjectDetail>).detail?.project;
        if (project?.id) open(project.id);
      },
      { signal },
    );
  }

  mountAll('[data-project-modal]', initProjectModal);
</script>
