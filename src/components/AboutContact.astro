<div id="contacto" class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch" data-about-contact>
  <div class="bg-[#1A1A1A] p-8 md:p-12 rounded-3xl text-white relative binary-texture overflow-hidden flex flex-col justify-between border border-[#2A2A2A]">
    <div class="relative z-10">
      <p class="font-technical text-sm font-bold text-[#fd625d] mb-6 uppercase tracking-widest">// nosotros</p>
      <h2 class="font-sora text-3xl md:text-4xl lg:text-[40px] font-bold mb-8 leading-tight">
        Pasión por el detalle
      </h2>
      <p class="font-inter text-base md:text-lg text-[#9CA3AF] mb-8 leading-relaxed">
        Nacimos de la idea de que el software no solo debe funcionar, sino debe ser una obra de ingeniería elegante. En Bit &amp; Byte Studio, combinamos años de experiencia en desarrollo con una visión creativa para entregar soluciones que realmente marcan la diferencia.
      </p>
    </div>

    <div class="relative z-10 pt-6 border-t border-[#2A2A2A] flex items-center gap-4">
      <div class="w-12 h-12 bg-[#fd625d] rounded-full flex items-center justify-center shrink-0 glow-coral">
        <span class="material-symbols-outlined text-white text-2xl">bolt</span>
      </div>
      <span class="font-technical text-sm md:text-base text-white font-bold">
        Hecho con precisión técnica.
      </span>
    </div>
  </div>

  <div class="bg-white p-8 md:p-12 rounded-3xl border border-[#E5E0D8] text-[#1A1A1A] flex flex-col justify-between">
    <div>
      <p class="font-technical text-sm font-bold text-[#fd625d] mb-4 uppercase tracking-widest">// hablemos</p>
      <h2 class="font-sora text-3xl md:text-4xl lg:text-[40px] font-bold text-[#1A1A1A] mb-8">
        ¿Tienes un proyecto?
      </h2>

      <div data-contact-success class="p-8 rounded-2xl bg-[#58ddb0]/10 border border-[#58ddb0] text-[#003828] text-center my-6 animate-fadeIn hidden" hidden>
        <div class="w-12 h-12 rounded-full bg-[#58ddb0] text-white flex items-center justify-center mx-auto mb-4">
          <span class="material-symbols-outlined text-3xl">check</span>
        </div>
        <h4 class="font-sora text-xl font-bold mb-2">¡Mensaje recibido con éxito!</h4>
        <p class="font-inter text-sm">
          Nuestro equipo de ingeniería en Bit &amp; Byte Studio revisará tu propuesta y te responderemos en menos de 24 horas.
        </p>
      </div>

      <form data-contact-form class="space-y-5">
        <div>
          <input
            type="text"
            name="name"
            placeholder="Nombre completo"
            class="w-full bg-[#F7F5F2] border border-[#E5E0D8] rounded-xl px-4 py-3.5 text-[#1A1A1A] placeholder:text-[#9CA3AF] focus:ring-2 focus:ring-[#fd625d] focus:border-[#fd625d] transition-all font-inter text-sm outline-none"
          />
        </div>
        <div>
          <input
            type="email"
            name="email"
            placeholder="Email"
            class="w-full bg-[#F7F5F2] border border-[#E5E0D8] rounded-xl px-4 py-3.5 text-[#1A1A1A] placeholder:text-[#9CA3AF] focus:ring-2 focus:ring-[#fd625d] focus:border-[#fd625d] transition-all font-inter text-sm outline-none"
          />
        </div>
        <div>
          <textarea
            name="message"
            rows="4"
            placeholder="Cuéntanos sobre tu proyecto..."
            class="w-full bg-[#F7F5F2] border border-[#E5E0D8] rounded-xl px-4 py-3.5 text-[#1A1A1A] placeholder:text-[#9CA3AF] focus:ring-2 focus:ring-[#fd625d] focus:border-[#fd625d] transition-all font-inter text-sm outline-none resize-none"
          ></textarea>
        </div>

        <p data-contact-error class="text-xs font-technical text-red-600 font-bold hidden" hidden>
          * Por favor completa tu nombre, email y un mensaje sobre tu proyecto.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <button
            type="submit"
            data-contact-submit
            class="bg-[#131315] text-white px-8 py-3.5 rounded-full font-sora text-sm font-semibold flex-grow hover:bg-[#1A1A1A] transition-all disabled:opacity-50"
          >
            Enviar mensaje
          </button>
          <button
            type="button"
            data-contact-whatsapp
            class="bg-[#25D366] text-white px-8 py-3.5 rounded-full font-sora text-sm font-semibold flex items-center justify-center gap-2 hover:brightness-105 transition-all shadow-md"
          >
            <span class="material-symbols-outlined text-lg">chat</span>
            <span>WhatsApp</span>
          </button>
        </div>
      </form>
    </div>

    <div class="mt-8 pt-6 border-t border-[#E5E0D8] flex items-center justify-between text-xs font-technical text-[#6A6A6E]">
      <span>RESPUESTA HABITUAL &lt; 2 HORAS</span>
      <span>SOPORTE 24/7 EN DESPLIEGUES</span>
    </div>
  </div>
</div>

<script>
  function initAboutContact(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-contact-form]');
    const success = root.querySelector<HTMLElement>('[data-contact-success]');
    const error = root.querySelector<HTMLElement>('[data-contact-error]');
    const submit = root.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const whatsapp = root.querySelector<HTMLButtonElement>('[data-contact-whatsapp]');

    if (!form || !success || !error || !submit || !whatsapp) return;

    const setErrorVisible = (visible: boolean) => {
      error.classList.toggle('hidden', !visible);
      error.hidden = !visible;
    };

    const setSuccessVisible = (visible: boolean) => {
      success.classList.toggle('hidden', !visible);
      success.hidden = !visible;
      form.classList.toggle('hidden', visible);
      form.hidden = visible;
    };

    form.addEventListener('input', () => setErrorVisible(false));

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const message = String(data.get('message') || '').trim();

      if (!name || !email || !message) {
        setErrorVisible(true);
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Enviando mensaje...';

      window.setTimeout(() => {
        form.reset();
        setErrorVisible(false);
        setSuccessVisible(true);
        submit.disabled = false;
        submit.textContent = 'Enviar mensaje';

        window.setTimeout(() => {
          setSuccessVisible(false);
        }, 6000);
      }, 900);
    });

    whatsapp.addEventListener('click', () => {
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const message = String(data.get('message') || '').trim();
      const text = message
        ? `Hola Bit & Byte Studio, mi nombre es ${name || 'un cliente'}. Mi proyecto: ${message}`
        : '¡Hola Bit & Byte Studio! Quisiera información para desarrollar un proyecto.';
      window.open(`https://wa.me/5350000000?text=${encodeURIComponent(text)}`, '_blank');
    });
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-about-contact]').forEach(initAboutContact);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
