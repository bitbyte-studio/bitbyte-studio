---
import { Picture } from 'astro:assets';
import { PROJECTS } from '../data';
---

<section id="portafolio" class="bg-[#131315] py-20 md:py-[120px]" data-portfolio>
  <div class="max-w-[1280px] mx-auto px-4 md:px-6">
    <div class="mb-12 md:mb-16 text-center flex flex-col items-center">
      <p class="font-technical text-sm font-bold text-[#fd625d] mb-2 uppercase tracking-widest">// portafolio</p>
      <h2 class="font-sora text-3xl md:text-4xl lg:text-[40px] font-bold text-white mb-4">
        Nuestros Proyectos
      </h2>
      <p class="font-inter text-sm md:text-base text-[#9CA3AF] max-w-xl">
        Demos hechas por Bit &amp; Byte Studio para mostrar lo que podemos hacer por tu negocio. Puedes abrirlas y probarlas.
      </p>
    </div>

    <div class="flex flex-col gap-16 md:gap-24" data-project-list>
      {
        PROJECTS.map((project, index) => {
          const isEven = index % 2 === 1;
          return (
            <article
              data-project-item
              data-project-id={project.id}
              class="project-item grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center"
            >
              <div class:list={[isEven ? 'order-1 lg:order-2' : 'order-2 lg:order-1']}>
                <div class="flex items-center gap-3 mb-3">
                  <span class="px-2.5 py-0.5 rounded-full bg-[#58ddb0]/10 border border-[#58ddb0]/40 text-[#58ddb0] font-technical text-xs font-bold uppercase tracking-wider">
                    {project.badge}
                  </span>
                  <span class="font-technical text-xs text-[#9CA3AF] uppercase tracking-wider">
                    {project.category}
                  </span>
                </div>

                <h3 class="font-sora text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-4">
                  {project.title}
                </h3>
                <p class="font-inter text-base md:text-lg text-[#9CA3AF] mb-6 leading-relaxed">
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-2 mb-8">
                  {project.tags.map((tag) => (
                    <span class="px-3 py-1 bg-[#fd625d]/10 border border-[#fd625d]/40 text-[#fd625d] rounded-full text-xs font-technical uppercase tracking-wider">
                      {tag}
                    </span>
                  ))}
                </div>

                <button
                  type="button"
                  data-open-project={project.id}
                  data-project-title={project.title}
                  class="text-white font-technical text-sm uppercase tracking-wider inline-flex items-center gap-2 hover:text-[#fd625d] transition-colors group cursor-pointer"
                >
                  <span>VER PROYECTO</span>
                  <span class="material-symbols-outlined text-lg group-hover:translate-x-2 transition-transform" aria-hidden="true">
                    arrow_forward
                  </span>
                </button>
              </div>

              <div
                role="button"
                tabindex="0"
                aria-label={`Ver proyecto ${project.title}`}
                data-open-project={project.id}
                data-project-title={project.title}
                class:list={[
                  'rounded-2xl overflow-hidden border border-[#2A2A2A] group cursor-pointer bg-[#1A1A1A] relative',
                  isEven ? 'order-2 lg:order-1' : 'order-1 lg:order-2',
                ]}
              >
                <Picture
                  src={project.image.card}
                  alt={`Vista previa de la demo ${project.title}`}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 1024px) 592px, calc(100vw - 2rem)"
                  loading="lazy"
                  decoding="async"
                  class="w-full aspect-[3/2] object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                  <span class="px-5 py-2.5 rounded-full bg-[#fd625d] text-white font-sora text-sm font-semibold glow-coral flex items-center gap-2">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
                    Ver detalles
                  </span>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { openProject } from '../lib/events';
  import { mountAll } from '../lib/lifecycle';

  function initPortfolio(root: HTMLElement, signal: AbortSignal) {
    root.querySelectorAll<HTMLElement>('[data-open-project]').forEach((el) => {
      const open = () => {
        const { openProject: id, projectTitle: title } = el.dataset;
        if (id) openProject({ id, title: title ?? id });
      };

      el.addEventListener('click', open, { signal });
      el.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            open();
          }
        },
        { signal },
      );
    });
  }

  mountAll('[data-portfolio]', initPortfolio);
</script>
